<div class="max-w-md mx-auto px-4 py-16 text-center">
  <h1 class="font-display text-3xl text-ink"><%= t(".title") %></h1>
  <p class="mt-4 text-muted"><%= t(".body") %></p>
  <a href="<%= root_path %>" class="mt-8 inline-flex items-center justify-center min-h-12 px-6 rounded-lg bg-ink text-canvas font-medium"><%= t(".retry") %></a>

  <%# Filled in from the service worker's saved-lessons list, on this device only. %>
  <section id="saved-lessons" hidden aria-labelledby="saved-lessons-heading" class="mt-12 text-left">
    <h2 id="saved-lessons-heading" class="font-mono text-xs uppercase tracking-wider text-muted"><%= t(".saved_heading") %></h2>
    <p class="mt-1 text-sm text-muted"><%= t(".saved_note") %></p>
    <ul class="mt-3 flex flex-col gap-2"></ul>
  </section>
</div>
<script>
  (async () => {
    if (!("caches" in window)) return
    try {
      const hit = await (await caches.open("gmh-pages")).match("/__saved-lessons")
      const lessons = hit ? await hit.json() : []
      if (!Array.isArray(lessons) || lessons.length === 0) return
      const section = document.getElementById("saved-lessons")
      const list = section.querySelector("ul")
      for (const lesson of lessons) {
        if (typeof lesson.path !== "string" || !/^\/lessons\/\d+$/.test(lesson.path)) continue
        const link = document.createElement("a")
        link.href = lesson.path
        link.className = "flex items-center min-h-12 px-4 py-3 bg-surface border border-line rounded-sm text-ink hover:border-ink"
        link.textContent = lesson.title || lesson.path
        const item = document.createElement("li")
        item.appendChild(link)
        list.appendChild(item)
      }
      if (list.children.length > 0) section.hidden = false
    } catch (error) {}
  })()
</script>
