<div class="max-w-xl mx-auto">
  <div class="card p-6 sm:p-10 flex flex-col gap-6">
    <div>
      <p class="eyebrow text-foghlaim mb-2">Babhta críochnaithe</p>
      <h1 class="font-display text-4xl leading-tight"><%= @correct %> as <%= @answered %></h1>
      <p class="text-muted mt-1">ceart sa bhabhta seo</p>
    </div>

    <%= render "shared/progress_bar", progress: @progress, label: "Stór focal ar eolas" %>

    <% if @progress.complete? %>
      <p class="text-sm text-foghlaim">Tá an stór focal ar fad ar eolas agat! Fillfidh ceisteanna le haghaidh athbhreithnithe.</p>
    <% end %>

    <div class="flex flex-col sm:flex-row gap-2">
      <%= link_to "Lean ar aghaidh", lesson_quiz_path(@lesson), class: "btn-solid" %>
      <%= link_to "Ar ais go dtí an ceacht", lesson_path(@lesson), class: "btn-outline border-line text-muted" %>
    </div>
  </div>
</div>
