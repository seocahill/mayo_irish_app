<div class="max-w-xl mx-auto">
  <div class="card p-6 sm:p-10 flex flex-col gap-6">
    <div>
      <p class="eyebrow text-foghlaim mb-2">Round complete</p>
      <h1 class="font-display text-4xl leading-tight"><%= @correct %> of <%= @answered %></h1>
      <p class="text-muted mt-1">correct this round</p>
    </div>

    <%= render "shared/progress_bar", progress: @progress, label: "Words known" %>

    <% if @progress.complete? %>
      <p class="text-sm text-foghlaim">You know all the vocabulary in this lesson. Questions will come back for review.</p>
    <% end %>

    <div class="flex flex-col sm:flex-row gap-2">
      <%= link_to "Keep going", lesson_quiz_path(@lesson), class: "btn-solid" %>
      <%= link_to "Back to the lesson", lesson_path(@lesson), class: "btn-outline border-line text-muted" %>
    </div>
  </div>
</div>
