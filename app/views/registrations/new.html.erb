<div class="max-w-md mx-auto mt-8">
  <h1 class="text-2xl font-bold text-stone-800 mb-2">Cláraigh</h1>
  <p class="text-stone-500 text-sm mb-6">Déanfar do chuntas a sheiceáil sula mbeidh rochtain agat.</p>

  <%= form_with model: @user, url: registration_path do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 mb-4 text-sm text-red-700">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :email_address, "Ríomhphost", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username",
              class: "w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :password, "Pasfhocal", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.password_field :password, required: true,
              autocomplete: "new-password",
              maxlength: 72,
              class: "w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Deimhnigh pasfhocal", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.password_field :password_confirmation, required: true,
              autocomplete: "new-password",
              maxlength: 72,
              class: "w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>

      <%= form.submit "Cláraigh",
            class: "w-full bg-emerald-800 text-white text-sm font-medium py-2 px-4 rounded-lg hover:bg-emerald-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-stone-500">
    Cuntas agat cheana? <%= link_to "Sínigh isteach", new_session_path, class: "text-emerald-700 hover:underline" %>
  </p>
</div>
