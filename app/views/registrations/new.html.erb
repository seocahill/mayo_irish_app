<div class="max-w-md mx-auto mt-8">
  <h1 class="text-2xl font-display text-ink mb-2">Register</h1>
  <p class="text-muted text-sm mb-6">Your account will be checked before you get access.</p>

  <%= form_with model: @user, url: registration_path do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-sm px-4 py-3 mb-4 text-sm text-red-700">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :email_address, "Email", class: "block text-sm font-semibold mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username",
              class: "field" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "block text-sm font-semibold mb-1" %>
        <%= form.password_field :password, required: true,
              autocomplete: "new-password",
              maxlength: 72,
              class: "field" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Deimhnigh pasfhocal", class: "block text-sm font-semibold mb-1" %>
        <%= form.password_field :password_confirmation, required: true,
              autocomplete: "new-password",
              maxlength: 72,
              class: "field" %>
      </div>

      <%= form.submit "Register",
            class: "btn-solid w-full" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-muted">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "text-ink underline underline-offset-2" %>
  </p>
</div>
