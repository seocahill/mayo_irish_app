<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= link_to t(".eyebrow"), course_tools_path, class: "hover:underline" %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
  </header>

  <%= form_with url: where_taught_path, method: :get, class: "flex gap-2", role: "search" do |f| %>
    <%= f.label :q, t(".label"), class: "sr-only" %>
    <%= f.search_field :q, value: @query, autofocus: true, autocomplete: "off",
          placeholder: t(".placeholder"), class: "field flex-1 min-h-12" %>
    <%= f.submit t(".look_up"), name: nil, class: "btn-solid min-h-12" %>
  <% end %>

  <% if @locator && !@locator.valid? %>
    <p class="text-sm text-muted" id="where-taught-short"><%= t(".too_short", count: WordLocator::MIN_LENGTH) %></p>
  <% elsif @locator %>
    <section aria-labelledby="where-taught-words">
      <h2 id="where-taught-words" class="eyebrow mb-3"><%= t(".words_heading") %></h2>
      <% if @locator.matches.empty? %>
        <p class="text-sm text-muted" id="where-taught-none"><%= t(".no_words", query: @query) %></p>
      <% else %>
        <ul class="flex flex-col gap-3">
          <% @locator.matches.each do |match| %>
            <% item = match.item %>
            <li class="card px-4 py-3 text-sm" id="where-taught-item-<%= item.id %>">
              <p><span lang="ga" class="font-semibold"><%= item.irish %></span> <span class="text-muted">· <%= item.english %></span></p>
              <p class="mt-1"><%= link_to item.lesson.display_title, lesson_path(item.lesson), class: "underline" %>
                <span class="text-muted">· <%= link_to t(".edit"), edit_lesson_path(item.lesson), class: "underline" %></span></p>
              <p class="mt-1 text-xs text-muted flex flex-wrap gap-x-3 gap-y-1">
                <span><%= match.has_recording ? t(".recorded") : t(".not_recorded") %></span>
                <span><%= t(".clips", count: match.listening_clips) %></span>
                <span><%= t(".questions", count: match.quiz_questions) %></span>
              </p>
            </li>
          <% end %>
        </ul>
        <% if @locator.matches.size >= WordLocator::LIMIT %>
          <p class="text-xs text-muted mt-2"><%= t(".first_only", count: WordLocator::LIMIT) %></p>
        <% end %>
      <% end %>
    </section>

    <section aria-labelledby="where-taught-phrases">
      <h2 id="where-taught-phrases" class="eyebrow mb-3"><%= t(".phrases_heading") %></h2>
      <%= render "where_taught/lessons", lessons: @locator.phrase_lessons, id: "where-taught-phrase-lessons" %>
    </section>

    <section aria-labelledby="where-taught-exercises">
      <h2 id="where-taught-exercises" class="eyebrow mb-3"><%= t(".exercises_heading") %></h2>
      <%= render "where_taught/lessons", lessons: @locator.exercise_lessons, id: "where-taught-exercise-lessons" %>
    </section>
  <% end %>
</div>
