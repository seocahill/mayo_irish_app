<turbo-frame id="<%= dom_id(@exercise) %>">
  <%= form_with model: @exercise do |f| %>
    <div class="flex items-start gap-4 px-5 py-3 border-b border-stone-100 bg-amber-50">
      <span class="text-stone-400 font-mono text-xs w-6 shrink-0 pt-2"><%= @exercise.number %>.</span>
      <div class="flex-1 space-y-2">
        <%= f.text_area :prompt, rows: 2,
              class: "w-full text-sm border border-stone-300 rounded px-2 py-1 focus:outline-none focus:border-emerald-500 resize-none",
              placeholder: "Béarla…" %>
        <%= f.text_area :answer, rows: 2,
              class: "w-full text-sm border border-stone-300 rounded px-2 py-1 focus:outline-none focus:border-emerald-500 resize-none text-emerald-800",
              placeholder: "Gaeilge (roghnach)…" %>
      </div>
      <div class="flex flex-col gap-1 shrink-0">
        <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-emerald-700 transition-colors cursor-pointer" %>
        <a href="<%= edit_lesson_path(@exercise.lesson) %>"
           data-turbo-frame="<%= dom_id(@exercise) %>"
           class="text-center text-stone-400 hover:text-stone-700 text-xs transition-colors">Cealaigh</a>
      </div>
    </div>
  <% end %>
</turbo-frame>
