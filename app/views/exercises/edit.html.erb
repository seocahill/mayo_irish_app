<turbo-frame id="<%= dom_id(@exercise) %>">
  <%= form_with model: @exercise do |f| %>
    <div class="flex items-start gap-4 px-5 py-3 border-b border-line bg-eist/10">
      <span class="text-muted font-mono text-xs w-6 shrink-0 pt-2"><%= @exercise.number %>.</span>
      <div class="flex-1 space-y-2">
        <%= f.text_area :prompt, rows: 2, class: "editor-textarea", placeholder: t(".english_placeholder") %>
        <%= f.text_area :answer, rows: 2, class: "editor-textarea", placeholder: t(".irish_placeholder") %>
      </div>
      <div class="flex flex-col gap-1 shrink-0">
        <%= f.submit t("shared.save"), class: "btn-solid !px-3 !py-1 text-xs" %>
        <a href="<%= edit_lesson_path(@exercise.lesson) %>"
           data-turbo-frame="<%= dom_id(@exercise) %>"
           class="text-center text-muted hover:text-ink text-xs transition-colors"><%= t("shared.cancel") %></a>
      </div>
    </div>
  <% end %>
</turbo-frame>
