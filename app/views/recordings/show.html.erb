<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header class="flex flex-col gap-2">
    <p class="eyebrow text-eist"><%= t(".eyebrow") %></p>
    <% if @recording %>
      <h1 class="font-display text-3xl leading-tight"><%= @recording.title.presence || t(".untitled") %></h1>
      <p class="text-xs text-muted"><%= [ @recording.speakers.to_sentence.presence, @recording.dialect_region&.humanize ].compact.join(" · ") %></p>
    <% end %>
    <p class="text-muted text-sm"><%= t(".how_to_listen") %></p>
  </header>

  <% if @error %>
    <p class="card px-4 py-6 text-center text-muted text-sm"><%= @error %></p>
  <% else %>
    <%= render "recording_questions/section", questions: @questions, recording_id: @recording.id %>

    <div class="flex flex-col gap-4"
         data-controller="playback transcript media-session listening-place"
         data-action="media-session:skipped->transcript#skipped listening-place:skipped->transcript#skipped playback:skipped->transcript#skipped"
         data-media-session-title-value="<%= @recording.title.presence || t(".untitled") %>"
         data-media-session-artist-value="<%= @recording.speakers.to_sentence.presence || t(".speaker_unknown") %>"
         data-media-session-album-value="<%= t("app_name") %>"
         data-media-session-artwork-value="/icon.png"
         data-listening-place-key-value="<%= current_user.id %>:<%= @recording.id %>"
         data-listening-place-offer-value="<%= params[:t].blank? %>"
         data-listening-place-label-value="<%= t(".carry_on", time: "__TIME__") %>"
         data-transcript-start-value="<%= @start %>"
         data-transcript-report-url-value="<%= recording_listening_time_path(@recording.id) %>">
      <div class="card px-4 py-4 flex flex-col gap-3 sticky top-0 z-10">
        <audio controls preload="metadata" src="<%= @recording.audio_url %>" class="w-full"
               data-playback-target="audio" data-transcript-target="audio" data-media-session-target="audio" data-listening-place-target="audio"
               data-action="timeupdate->transcript#follow play->transcript#started pause->transcript#report ended->transcript#report timeupdate->listening-place#track pause->listening-place#save ended->listening-place#clear"></audio>
        <button type="button" class="btn-solid text-sm self-start" hidden
                data-listening-place-target="carryOn" data-action="listening-place#carryOn"><%= t(".carry_on_fallback") %></button>
        <div class="flex flex-wrap gap-2">
          <%= render "shared/playback_back" %>
          <%= render "shared/playback_speed" %>
          <button type="button" class="btn-outline text-sm aria-pressed:border-eist aria-pressed:text-eist" aria-pressed="false"
                  data-transcript-target="repeatToggle" data-action="transcript#toggleRepeat"><%= t(".repeat") %></button>
          <button type="button" class="btn-outline text-sm aria-pressed:border-eist aria-pressed:text-eist" aria-pressed="false"
                  data-transcript-target="englishToggle" data-action="transcript#toggleEnglish"><%= t(".show_english") %></button>
          <% if @recording.lines.any? %>
            <button type="button" class="btn-outline text-sm aria-pressed:border-eist aria-pressed:text-eist" aria-pressed="false"
                    data-transcript-target="wordsToggle" data-action="transcript#toggleWords"><%= t(".hide_words") %></button>
          <% end %>
        </div>
        <%= render "shared/playback_keys" %>
      </div>

      <% if @recording.lines.empty? %>
        <p class="text-sm text-muted"><%= t(".no_transcript") %></p>
      <% else %>
        <%# With the words hidden, each Irish line is a blank bar: the timing, highlight, tap-to-play and Repeat line still work.
            The text is only made transparent, so find-in-page can still reveal it; fine for a learning aid. %>
        <ol class="group flex flex-col" data-transcript-target="lines">
          <% @recording.turns.each do |turn| %>
            <% if turn.first.speaker %>
              <li><p class="eyebrow mt-3 mb-1"><%= turn.first.speaker %></p></li>
            <% end %>
            <% turn.each do |line| %>
              <li>
                <button type="button" class="w-full text-left rounded-sm px-2 py-1.5 border-l-2 border-transparent hover:bg-canvas aria-[current=true]:border-eist aria-[current=true]:bg-surface"
                        data-transcript-target="line" data-media-session-target="line" data-start="<%= line.start %>" data-end="<%= line.end %>"
                        data-action="transcript#seek">
                  <span lang="ga" class="block group-data-words-hidden:text-transparent group-data-words-hidden:bg-line group-data-words-hidden:rounded-sm group-data-words-hidden:select-none"
                        data-transcript-target="irish"><%= line.irish %></span>
                  <span class="sr-only" hidden data-transcript-target="hiddenLine"><%= t(".hidden_line", time: "%d:%02d" % line.start.to_i.divmod(60)) %></span>
                  <% if line.english %>
                    <span class="block text-sm text-muted" hidden data-transcript-target="english"><%= line.english %></span>
                  <% end %>
                </button>
              </li>
            <% end %>
          <% end %>
        </ol>
      <% end %>
      <p class="text-xs text-muted"><%= t(".from_abairt") %></p>
    </div>
  <% end %>
</div>
