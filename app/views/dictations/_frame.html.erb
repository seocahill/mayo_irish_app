<%# "Type what you hear" on a listening clip: the form, and once checked, what the learner typed lined up against the speaker's words (see Dictation). %>
<%= turbo_frame_tag "dictation" do %>
  <% if dictation&.attempted? %>
    <div class="flex flex-col gap-3" data-testid="dictation-result">
      <p class="font-medium focus:outline-none" role="status" tabindex="-1" autofocus>
        <%= dictation.all_heard? ? t("dictations.frame.all_heard") : t("dictations.frame.heard", count: dictation.heard_count, total: dictation.words.size) %>
      </p>
      <p lang="ga" class="text-lg leading-relaxed break-words">
        <% dictation.words.each do |word| %>
          <% case word.status %>
          <% when :heard %>
            <span data-status="heard"><%= word.text %><% if word.fada_missing? %><span class="sr-only" lang="en"> (<%= t("dictations.frame.fada") %>)</span><sup class="font-mono text-[9px] uppercase tracking-wider text-muted ml-0.5" lang="en" aria-hidden="true"><%= t("dictations.frame.fada_mark") %></sup><% end %></span>
          <% when :different %>
            <span data-status="different"><span class="underline decoration-wavy decoration-labhair underline-offset-4"><%= word.text %></span><span class="sr-only" lang="en">, <%= t("dictations.frame.you_typed") %></span> <span class="text-xs text-muted">(<%= word.typed %>)</span></span>
          <% else %>
            <span class="text-muted underline decoration-dotted underline-offset-4" data-status="missed"><%= word.text %><span class="sr-only" lang="en"> (<%= t("dictations.frame.missed") %>)</span></span>
          <% end %>
        <% end %>
      </p>
      <p class="text-muted"><%= clip.english %></p>
      <p class="text-xs text-muted"><%= t("dictations.frame.legend") %></p>
      <p class="text-sm"><%= dictation.all_heard? ? t("dictations.frame.then_all") : t("dictations.frame.then_some") %></p>
    </div>
  <% end %>
  <div class="<%= "mt-4 pt-4 border-t border-line" if dictation&.attempted? %>">
    <%= render "dictations/form", clip: clip, heard: dictation&.heard %>
  </div>
<% end %>
