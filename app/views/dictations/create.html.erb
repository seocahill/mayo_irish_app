<%= turbo_frame_tag "dictation" do %>
  <% if @dictation.attempted? %>
    <div class="flex flex-col gap-3" data-testid="dictation-result">
      <p class="font-medium" role="status">
        <%= @dictation.all_heard? ? t(".all_heard") : t(".heard", count: @dictation.heard_count, total: @dictation.words.size) %>
      </p>
      <p lang="ga" class="text-lg leading-relaxed break-words">
        <% @dictation.words.each do |word| %>
          <% case word.status %>
          <% when :heard %>
            <span class="text-ink" data-status="heard"><%= word.text %><% if word.fada_missing? %><span class="sr-only"> (<%= t(".fada") %>)</span><sup class="text-[10px] text-muted ml-0.5" aria-hidden="true"><%= t(".fada_mark") %></sup><% end %></span>
          <% when :different %>
            <span data-status="different"><span class="underline decoration-wavy decoration-amber-600 underline-offset-4"><%= word.text %></span><span class="sr-only"> (<%= t(".you_typed", typed: word.typed) %>)</span><span class="text-xs text-muted ml-1" lang="ga" aria-hidden="true">(<%= word.typed %>)</span></span>
          <% else %>
            <span class="text-muted underline decoration-dotted underline-offset-4" data-status="missed"><%= word.text %><span class="sr-only"> (<%= t(".missed") %>)</span></span>
          <% end %>
        <% end %>
      </p>
      <p class="text-muted"><%= @clip.english %></p>
      <p class="text-xs text-muted"><%= t(".legend") %></p>
      <p class="text-sm"><%= @dictation.all_heard? ? t(".then_all") : t(".then_some") %></p>
    </div>
  <% end %>
  <div class="<%= "mt-4 pt-4 border-t border-line" if @dictation.attempted? %>">
    <%= render "dictations/form", clip: @clip, heard: params[:heard].to_s.first(Dictation::MAX_LENGTH) %>
  </div>
<% end %>
