<div class="max-w-xl mx-auto flex flex-col gap-6">
  <header>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted"><%= t(".intro") %></p>
  </header>

  <% if @entries.any? %>
    <ul class="bg-surface border border-line rounded-sm divide-y divide-line">
      <% @entries.each do |entry| %>
        <li class="px-4 py-4 flex flex-col gap-1">
          <p class="font-mono text-[11px] uppercase tracking-wider text-muted">
            <%= l(entry.date, format: :long) %>
            <% if @new_ids.include?(entry.id) %>
              <span class="text-foghlaim">· <%= t(".new") %></span>
            <% end %>
          </p>
          <p class="font-semibold leading-snug"><%= entry.title %></p>
          <p class="text-muted leading-snug"><%= entry.body %></p>
          <% if entry.path %>
            <%= link_to t(".try_it"), entry.path, class: "text-sm underline underline-offset-2 self-start py-1" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="bg-surface border border-line rounded-sm px-4 py-5 text-muted"><%= t(".nothing_yet") %></p>
  <% end %>

  <%= link_to t(".back"), root_path, class: "text-sm text-muted underline underline-offset-2 hover:text-ink self-start" %>
</div>
