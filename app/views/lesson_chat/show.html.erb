<div class="max-w-2xl mx-auto">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <div class="text-sm text-stone-400 uppercase tracking-widest mb-1">Ceacht <%= @lesson.number %></div>
      <h1 class="text-2xl font-bold text-stone-800"><%= @lesson.title %></h1>
    </div>
    <a href="<%= lesson_path(@lesson) %>" class="text-sm text-stone-500 hover:text-stone-800 transition-colors">
      ← Ar ais go dtí an ceacht
    </a>
  </div>

  <%# Chat window %>
  <div class="bg-white rounded-xl border border-stone-200 flex flex-col" style="height: 70vh;">

    <%# Messages %>
    <div id="chat-messages" class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
      <% if @messages.empty? %>
        <div class="text-stone-400 text-sm text-center mt-8">
          Clóscríobh "tosaigh" nó aon rud chun tús a chur leis an gceacht.
        </div>
      <% else %>
        <% @messages.each do |msg| %>
          <% if msg.role == "user" %>
            <div class="flex justify-end">
              <div class="bg-emerald-800 text-white rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%] text-sm">
                <%= msg.content %>
              </div>
            </div>
          <% else %>
            <div class="flex justify-start">
              <div class="bg-stone-100 text-stone-800 rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%] text-sm whitespace-pre-wrap">
                <%= msg.content %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Input %>
    <div class="border-t border-stone-200 px-4 py-3">
      <%= form_with url: message_lesson_chat_path(@lesson), method: :post,
            data: { controller: "chat", action: "submit->chat#submit" } do |f| %>
        <div class="flex gap-2 items-end">
          <%= f.text_area :message,
                placeholder: "Scríobh do fhreagra...",
                rows: 1,
                class: "flex-1 resize-none rounded-xl border border-stone-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent",
                data: { chat_target: "input", action: "keydown.enter->chat#submitOnEnter" },
                autofocus: true %>
          <button type="submit"
                  class="bg-emerald-800 hover:bg-emerald-700 text-white rounded-xl px-4 py-2.5 text-sm font-medium transition-colors shrink-0">
            Seol
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <%# Clear session link %>
  <div class="mt-3 text-right">
    <%= button_to "Tosaigh arís", clear_lesson_chat_path(@lesson), method: :delete,
          class: "text-xs text-stone-400 hover:text-red-500 transition-colors bg-transparent border-none cursor-pointer" %>
  </div>
</div>

<script>
  // Scroll to bottom on load
  document.addEventListener("DOMContentLoaded", function() {
    const el = document.getElementById("chat-messages");
    if (el) el.scrollTop = el.scrollHeight;
  });
</script>
