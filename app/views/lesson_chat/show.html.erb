<div class="max-w-2xl mx-auto">
  <%# Header %>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4 mb-6">
    <div>
      <div class="eyebrow text-cleacht mb-1"><%= t(".practise_label", number: @lesson.number) %></div>
      <h1 class="text-3xl font-display text-ink leading-tight"><%= @lesson.title %></h1>
    </div>
    <a href="<%= lesson_path(@lesson) %>" class="text-sm text-muted hover:text-ink transition-colors shrink-0">
      <%= t(".back_to_lesson") %>
    </a>
  </div>

  <%# Chat window %>
  <div class="card flex flex-col" style="height: 70vh;">

    <%# Messages %>
    <div id="chat-messages" class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
      <% if @messages.empty? %>
        <div class="text-muted text-sm text-center mt-8">
          <%= t(".empty_state") %>
        </div>
      <% else %>
        <% @messages.each do |msg| %>
          <% if msg.role == "user" %>
            <div class="flex justify-end">
              <div class="bg-ink text-surface rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%] text-sm">
                <%= msg.content %>
              </div>
            </div>
          <% else %>
            <div class="flex justify-start">
              <div class="bg-cleacht/10 border border-line text-ink rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%] text-sm whitespace-pre-wrap">
                <%= msg.content %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Input %>
    <div class="border-t border-line px-4 py-3">
      <%= form_with url: message_lesson_chat_path(@lesson), method: :post,
            data: { controller: "chat", action: "submit->chat#submit" } do |f| %>
        <div class="flex gap-2 items-end">
          <%= f.text_area :message,
                placeholder: t(".placeholder"),
                rows: 1,
                class: "flex-1 resize-none rounded-sm border border-line bg-surface px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-ink",
                data: { chat_target: "input", action: "keydown.enter->chat#submitOnEnter" },
                autofocus: true %>
          <button type="submit"
                  class="btn-solid shrink-0">
            <%= t(".send") %>
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <%# Clear session link %>
  <div class="mt-3 text-right">
    <%= button_to t(".start_again"), clear_lesson_chat_path(@lesson), method: :delete,
          class: "text-sm text-muted hover:text-ink transition-colors bg-transparent border-none cursor-pointer" %>
  </div>
</div>

<script>
  // Scroll to bottom on load
  document.addEventListener("DOMContentLoaded", function() {
    const el = document.getElementById("chat-messages");
    if (el) el.scrollTop = el.scrollHeight;
  });
</script>
