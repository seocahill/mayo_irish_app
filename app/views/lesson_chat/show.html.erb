<div class="max-w-2xl mx-auto">
  <%# Header %>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4 mb-6">
    <div>
      <div class="eyebrow text-cleacht mb-1"><%= t(".practise_label", number: @lesson.number) %></div>
      <h1 class="text-3xl font-display text-ink leading-tight"><%= @lesson.title %></h1>
    </div>
    <a href="<%= lesson_path(@lesson) %>" class="text-sm text-muted hover:text-ink transition-colors shrink-0">
      <%= t(".back_to_lesson") %>
    </a>
  </div>

  <p class="mb-4 bg-eist/10 border border-eist/30 rounded-sm px-4 py-3 text-sm text-ink" role="note">
    <%= t(".ai_notice") %>
  </p>
  <% if @messages.any?(&:spoken?) %>
    <p id="heard-as-note" class="-mt-2 mb-4 text-xs text-muted" data-testid="heard-as-note"><%= t(".heard_as_note") %></p>
  <% end %>

  <% if @speech %>
    <p class="-mt-2 mb-4 text-xs text-muted" data-synthetic-note><%= t(".hear_selection_note") %></p>
  <% end %>

  <%# Chat window. Any Irish in it can be selected and heard (see the speakable controller). %>
  <div class="relative" <%= tag.attributes(data: { controller: "speakable", speakable_src_value: speech_path }) if @speech %>>
    <% if @speech %>
      <%= render "shared/hear_selection" %>
    <% end %>
    <div class="card flex flex-col" style="height: 70vh;">

      <%# Messages %>
      <div id="chat-messages" class="flex-1 overflow-y-auto px-6 py-5 space-y-4" data-controller="scroll-to-end" <%= tag.attributes(data: { action: "scroll->speakable#hide" }) if @speech %>>
        <% if @messages.empty? %>
          <div class="text-muted text-sm text-center mt-8">
            <%= t(".empty_state") %>
          </div>
        <% else %>
          <% @messages.each do |msg| %>
            <% if msg.spoken? %>
              <%# A spoken answer's words are the recogniser's, not the learner's own: say so. %>
              <div class="flex flex-col items-end gap-1" data-testid="spoken-turn">
                <p class="text-xs text-muted" aria-describedby="heard-as-note"><%= t(".heard_as") %></p>
                <div lang="ga" class="bg-ink text-surface rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%] text-sm break-words"><%= msg.content %></div>
              </div>
            <% elsif msg.role == "user" %>
              <div class="flex justify-end">
                <div class="bg-ink text-surface rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%] text-sm">
                  <%= msg.content %>
                </div>
              </div>
            <% else %>
              <div class="flex justify-start">
                <div class="bg-cleacht/10 border border-line text-ink rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%] text-sm flex flex-col items-start gap-2">
                  <p class="whitespace-pre-wrap break-words"><%= msg.content %></p>
                  <span class="chip border-line text-muted"><%= t(".ai_generated") %></span>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%# Input %>
      <div class="border-t border-line px-4 py-3">
        <%= form_with url: message_lesson_chat_path(@lesson), method: :post, multipart: true,
              data: { controller: "chat speech-input", action: "submit->speech-input#submit turbo:submit-start->speech-input#busy", speakable_ignore: true } do |f| %>
          <%= f.file_field :audio, accept: "audio/*", class: "hidden", tabindex: -1, "aria-hidden": true,
                data: { speech_input_target: "audio" } %>
          <%= hidden_field_tag :spoken_seconds, nil, id: nil, data: { speech_input_target: "spokenSeconds" } %>
          <div class="flex gap-2 items-end">
            <%= f.text_area :message,
                  placeholder: t(".placeholder"),
                  "aria-label": t(".placeholder"),
                  rows: 1,
                  class: "flex-1 min-w-0 resize-none rounded-sm border border-line bg-surface px-4 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-ink",
                  data: { chat_target: "input", speech_input_target: "input", action: "keydown.enter->chat#submitOnEnter" },
                  autofocus: true %>
            <% if @speech %>
              <button type="button"
                      data-speech-input-target="micButton"
                      data-action="speech-input#toggle"
                      class="btn-outline shrink-0 px-3 data-[state=recording]:text-red-600 data-[state=recording]:border-red-600 data-[state=recording]:animate-pulse disabled:opacity-50"
                      title="<%= t(".record") %>" aria-label="<%= t(".record") %>">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/>
                </svg>
              </button>
            <% end %>
            <%= f.button t(".send"), class: "btn-solid shrink-0", data: { turbo_submits_with: t(".thinking") } %>
          </div>
          <% if @speech %>
            <p data-speech-input-target="status" class="text-xs text-muted mt-2 min-h-4" aria-live="polite"><%= t(".record_hint") %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Clear session link %>
  <div class="mt-3 text-right">
    <%= button_to t(".start_again"), clear_lesson_chat_path(@lesson), method: :delete,
          class: "text-sm text-muted hover:text-ink transition-colors bg-transparent border-none cursor-pointer" %>
  </div>
</div>
