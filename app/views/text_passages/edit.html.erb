<turbo-frame id="<%= dom_id(@passage) %>" class="block bg-surface rounded-sm border border-line overflow-hidden">
  <%= form_with model: @passage do |f| %>
    <div class="bg-canvas border-b border-line px-5 py-3 flex items-center gap-3">
      <%= f.text_field :title, class: "editor-input flex-1 !py-1 text-sm font-semibold", placeholder: t(".title_placeholder") %>
      <%= f.submit t("shared.save"), class: "btn-solid !px-3 !py-1 text-xs" %>
      <a href="<%= edit_lesson_path(@passage.lesson) %>"
         data-turbo-frame="<%= dom_id(@passage) %>"
         class="text-muted hover:text-ink text-xs transition-colors"><%= t("shared.cancel") %></a>
    </div>
    <div class="px-5 py-4">
      <%= f.rich_text_area :body %>
    </div>
  <% end %>
</turbo-frame>
