<turbo-frame id="<%= dom_id(@passage) %>" class="block bg-white rounded-xl border border-stone-200 overflow-hidden">
  <%= form_with model: @passage do |f| %>
    <div class="bg-stone-700 px-5 py-3 flex items-center gap-3">
      <%= f.text_field :title,
            class: "flex-1 bg-stone-600 text-white placeholder-stone-400 text-sm font-bold rounded px-2 py-1 border border-stone-500 focus:outline-none focus:border-stone-300",
            placeholder: "Teideal…" %>
      <%= f.submit "Sábháil", class: "bg-white text-stone-800 px-3 py-1 rounded text-xs font-semibold hover:bg-stone-100 transition-colors cursor-pointer" %>
      <a href="<%= edit_lesson_path(@passage.lesson) %>"
         data-turbo-frame="<%= dom_id(@passage) %>"
         class="text-stone-300 hover:text-white text-xs transition-colors">Cealaigh</a>
    </div>
    <div class="px-5 py-4">
      <%= f.rich_text_area :body %>
    </div>
  <% end %>
</turbo-frame>
