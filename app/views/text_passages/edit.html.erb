<div class="flex items-center justify-between mb-6">
  <div>
    <div class="text-xs text-stone-400 uppercase tracking-widest mb-1">Ceacht <%= @passage.lesson.number %> · Téacsanna</div>
    <h1 class="text-xl font-bold text-stone-800"><%= @passage.title.presence || "Téacs" %></h1>
  </div>
  <a href="<%= edit_lesson_path(@passage.lesson) %>" class="text-sm text-stone-500 hover:text-stone-800 transition-colors">← Ar ais</a>
</div>

<%= form_with model: @passage, class: "bg-white rounded-xl border border-stone-200 overflow-hidden" do |f| %>
  <div class="px-6 py-4 border-b border-stone-100">
    <label class="editor-label">Teideal</label>
    <%= f.text_field :title, class: "editor-input", placeholder: "AG AN DOCHTÚR…" %>
  </div>
  <div class="px-6 py-4">
    <label class="editor-label">Téacs</label>
    <%= f.rich_text_area :body %>
  </div>
  <div class="px-6 py-4 border-t border-stone-100 flex justify-between">
    <a href="<%= edit_lesson_path(@passage.lesson) %>" class="text-stone-500 hover:text-stone-800 text-sm transition-colors">Cealaigh</a>
    <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-6 py-2 rounded-lg font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
