<%# With Turbo only the frame is used. Without it, this is a small page of its own. %>
<div class="max-w-2xl mx-auto">
  <p class="mb-4"><%= link_to t("exercise_attempts.create.back"), lesson_path(@exercise.lesson, anchor: "exercises"), class: "text-sm text-muted hover:text-ink" %></p>
  <h1 class="font-display text-2xl mb-4"><%= @exercise.lesson.display_title %> · <%= t("exercises.label", number: @exercise.number) %></h1>
  <div class="card px-5 py-4">
    <p id="<%= dom_id(@exercise, :prompt) %>" class="mb-3"><%= @exercise.prompt %></p>
    <%= render "exercise_attempts/frame", exercise: @exercise, comparison: @comparison %>
  </div>
</div>
