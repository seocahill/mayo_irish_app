<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= link_to t(".eyebrow"), course_tools_path, class: "hover:underline" %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
  </header>

  <% if @rows.empty? %>
    <p class="card px-4 py-3 text-sm text-muted" id="hard-recordings-none"><%= t(".none") %></p>
  <% else %>
    <ol class="flex flex-col gap-3" id="hard-recordings">
      <% @rows.each do |row| %>
        <% title = row.title.presence || t(".untitled") %>
        <li class="card px-4 py-3 text-sm" id="hard-recording-<%= row.recording_id %>">
          <p class="font-semibold"><%= title %></p>
          <dl class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-1">
            <div>
              <dt class="text-xs text-muted"><%= t(".not_yet") %></dt>
              <dd class="tabular-nums"><%= t(".not_yet_value", not_yet: row.not_yet, answers: row.answers, percent: row.not_yet_percent) %></dd>
            </div>
            <div>
              <dt class="text-xs text-muted"><%= t(".questions") %></dt>
              <dd class="tabular-nums"><%= row.questions %></dd>
            </div>
            <div>
              <dt class="text-xs text-muted"><%= t(".lesson") %></dt>
              <dd><%= link_to row.lesson.display_title, lesson_path(row.lesson), class: "underline" %><% unless row.lesson.published? %> <span class="chip text-[10px]"><%= t(".draft") %></span><% end %></dd>
            </div>
          </dl>
          <p class="mt-1 text-xs flex flex-wrap gap-x-4">
            <%= link_to recording_path(row.recording_id), class: "underline inline-flex items-center min-h-12 sm:min-h-0" do %><%= t(".open_recording") %><span class="sr-only"> <%= title %></span><% end %>
            <%= link_to recording_path(row.recording_id, anchor: "questions"), class: "underline inline-flex items-center min-h-12 sm:min-h-0" do %><%= t(".add_questions") %><span class="sr-only"> <%= title %></span><% end %>
          </p>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
