<div class="max-w-xl mx-auto flex flex-col gap-6">
  <header class="flex flex-col gap-2">
    <p class="eyebrow text-eist"><%= t(".eyebrow") %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted text-sm">
      <%= t(".listen_for_html", word: tag.span(@clip.vocabulary_item.irish, lang: "ga", class: "text-ink font-medium"), english: @clip.vocabulary_item.english) %>
    </p>
  </header>

  <div class="card px-4 py-5 flex flex-col items-center gap-3" data-controller="playback">
    <audio controls preload="auto" src="<%= @clip.audio_url %>" class="w-full" data-playback-target="audio"></audio>
    <button type="button" class="btn-outline text-sm aria-pressed:border-eist aria-pressed:text-eist" aria-pressed="false" data-playback-target="toggle" data-action="playback#toggleSlow">
      <%= t(".slower") %>
    </button>
  </div>

  <details class="card px-4 py-4">
    <summary class="cursor-pointer font-medium"><%= t(".show_words") %></summary>
    <div class="mt-3 flex flex-col gap-1">
      <p lang="ga" class="text-lg break-words"><%= @clip.irish %></p>
      <p class="text-muted"><%= @clip.english %></p>
      <p class="text-xs text-muted mt-1"><%= [ @clip.speaker_name, @clip.speaker_dialect&.humanize ].compact.join(" · ") %></p>
    </div>
  </details>

  <section class="flex flex-col gap-3">
    <h2 class="eyebrow"><%= t(".how_did_it_go") %></h2>
    <div class="flex flex-wrap gap-2">
      <%= button_to t(".understood"), listening_clip_listen_path(@clip), params: { understood: true }, class: "btn-solid" %>
      <%= button_to t(".not_yet"), listening_clip_listen_path(@clip), params: { understood: false }, class: "btn-outline" %>
    </div>
  </section>

  <% if current_user.admin? %>
    <div class="flex flex-wrap items-center gap-3 text-sm border-t border-line pt-4">
      <% if @clip.listed? %>
        <%= button_to t(".hide"), listening_clip_path(@clip), method: :patch, params: { status: "hidden" }, class: "btn-outline border-line text-muted" %>
      <% else %>
        <span class="chip border-line text-muted"><%= t(".hidden") %></span>
        <%= button_to t(".list"), listening_clip_path(@clip), method: :patch, params: { status: "listed" }, class: "btn-outline border-line text-muted" %>
      <% end %>
      <%= link_to t(".all_clips", number: @clip.vocabulary_item.lesson.number), lesson_listening_clips_path(@clip.vocabulary_item.lesson), class: "text-muted hover:text-ink" %>
    </div>
  <% end %>
</div>
