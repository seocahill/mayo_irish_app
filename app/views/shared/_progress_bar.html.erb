<%# locals: progress (LessonProgress), label (optional String) %>
<% label ||= "Dul chun cinn" %>
<div>
  <div class="flex items-baseline justify-between eyebrow mb-1.5">
    <span><%= label %></span>
    <span class="tabular-nums"><%= progress.known %>/<%= progress.total %><% if progress.complete? %> · Críochnaithe<% end %></span>
  </div>
  <div class="meter">
    <div class="h-full rounded-full bg-foghlaim transition-all duration-500" style="width: <%= progress.pct %>%"></div>
  </div>
</div>
