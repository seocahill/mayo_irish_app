// Offline support.
// - The app shell (CSS, fonts, icon and the /offline page) is cached on install
//   so a failed page load shows something friendly, not the browser's error.
// - Lesson pages go to the network first, so they are never stale while online.
//   A copy of the last few a learner opened is kept, and shown only when the
//   network fails or hangs. Signing in or out, an expired session or a
//   password reset clears them, so the next person never sees them.
//   To remove this feature, ship a worker that deletes "gmh-pages" and
//   "gmh-assets"; reverting alone would leave the saved pages on devices.
// - Fingerprinted assets (/assets/name-digest.ext) never change, so they are
//   kept as they are fetched and a saved lesson still looks right offline.
// Audio, practice and every other page still need the network.
<% shell_assets = %w[fonts.css tailwind.css application.css figtree-latin.woff2 young-serif-400-latin.woff2].map { |name| asset_path(name) } %>
const CACHE = "gmh-shell-<%= Digest::SHA1.hexdigest((shell_assets + [ Rails.root.join("app/views/offlines/show.html.erb"), Rails.root.join("app/views/layouts/offline.html.erb"), Rails.root.join("public/icon.png") ].map { |f| f.is_a?(Pathname) ? Digest::SHA1.file(f).hexdigest : f }).join) %>"
const OFFLINE_URL = "/offline"
const SHELL = <%= raw(([ "/offline", "/icon.png" ] + shell_assets).to_json) %>
// Not versioned: saved lessons and assets outlive a deploy.
const PAGES = "gmh-pages"
const ASSETS = "gmh-assets"
const INDEX_URL = "/__saved-lessons"
const MAX_PAGES = 10
const MAX_ASSETS = 80
const LESSON_PATH = /^\/lessons\/\d+$/
const ASSET_PATH = /^\/assets\/.+-[0-9a-f]{7,}\.[a-z0-9]+$/

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(CACHE).then(async (cache) => {
      const assets = await caches.open(ASSETS)
      // Fetch without cookies and keep only good responses.
      for (const url of SHELL) {
        const response = await fetch(new Request(url, { credentials: "omit", cache: "reload" }))
        if (!response.ok || response.redirected) throw new Error(`Could not cache ${url}`)
        // Fingerprinted shell files also go in the long-lived asset cache, so
        // a lesson saved before a deploy keeps its styles after it.
        if (ASSET_PATH.test(url)) await assets.put(url, response.clone())
        await cache.put(url, response)
      }
    }).then(() => self.skipWaiting())
  )
})

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(keys.filter((key) => key.startsWith("gmh-shell-") && key !== CACHE).map((key) => caches.delete(key))))
      .then(() => self.clients.claim())
  )
})

// Anything that signs someone in or out, or resets a password, forgets the
// saved lessons: so does any visit to the sign-in page, which is where an
// expired session lands. The saved pages are one person's.
const FORGET_POSTS = [ /^\/session$/, /^\/registration$/, /^\/passwords(\/.*)?$/ ]
const SIGN_IN_PATH = "/session/new"
const PAGE_TIMEOUT_MS = 5000

self.addEventListener("fetch", (event) => {
  const request = event.request
  const url = new URL(request.url)
  const sameOrigin = url.origin === self.location.origin

  if (sameOrigin && request.method === "POST" && FORGET_POSTS.some((path) => path.test(url.pathname))) {
    event.waitUntil(forgetPages())
    return
  }
  if (request.method !== "GET") return
  if (sameOrigin && url.pathname === SIGN_IN_PATH) event.waitUntil(forgetPages())

  if (sameOrigin && LESSON_PATH.test(url.pathname) && !url.search && isPageRequest(request)) {
    event.respondWith(lessonPage(event, request))
    return
  }

  if (request.mode === "navigate") {
    event.respondWith(
      fetch(request).catch(() => caches.match(OFFLINE_URL))
    )
    return
  }

  if (sameOrigin && SHELL.includes(url.pathname)) {
    event.respondWith(caches.match(request).then((hit) => hit || fetch(request)))
    return
  }

  if (sameOrigin && ASSET_PATH.test(url.pathname)) {
    event.respondWith(asset(event, request))
  }
})

// A lesson page tells the worker it was opened. Turbo often shows a lesson
// from a prefetch the worker deliberately doesn't keep, so this is how such a
// visit gets saved. A copy saved in the last minute is left as it is.
self.addEventListener("message", (event) => {
  const data = event.data || {}
  if (data.type !== "lesson-opened" || typeof data.path !== "string" || !LESSON_PATH.test(data.path)) return
  event.waitUntil(saveIfStale(data.path))
})

// Page-cache work runs one step at a time, so a save and a sign-out never
// interleave. A save started before a sign-out is dropped (generation check).
let pageQueue = Promise.resolve()
let generation = 0

function queuePages(task) {
  pageQueue = pageQueue.then(task, task)
  return pageQueue.catch(() => {})
}

function forgetPages() {
  generation += 1
  return queuePages(() => caches.delete(PAGES))
}

// A full page load, or a Turbo visit (a fetch asking for HTML). Turbo frame
// loads and hover prefetches are left alone, so only lessons opened are kept.
function isPageRequest(request) {
  if (request.mode === "navigate") return true
  const h = request.headers
  return (h.get("Accept") || "").includes("text/html") && !h.get("Turbo-Frame") &&
    h.get("X-Sec-Purpose") !== "prefetch" && h.get("Sec-Purpose") !== "prefetch"
}

// Network first. If the network fails, or a saved copy exists and the network
// has not answered within a few seconds (a connection that is up but barely
// working), the saved copy is shown; a slow answer still updates it.
async function lessonPage(event, request) {
  const path = new URL(request.url).pathname
  const started = generation
  const network = fetch(request).then((response) => {
    if (isLessonPage(response)) event.waitUntil(savePage(path, response.clone(), started))
    else if (response.redirected || response.type === "opaqueredirect") event.waitUntil(forgetPages())
    return response
  })
  event.waitUntil(network.catch(() => {}))

  const saved = await savedPage(path)
  if (!saved) return network.catch(async () => (await caches.match(OFFLINE_URL)) || Response.error())

  const timeout = new Promise((resolve) => setTimeout(() => resolve(null), PAGE_TIMEOUT_MS))
  try {
    return (await Promise.race([ network, timeout ])) || (await savedPage(path)) || network
  } catch (error) {
    return (await savedPage(path)) || (await caches.match(OFFLINE_URL)) || Response.error()
  }
}

// Only a real lesson page: not a redirect to sign in, not an error.
function isLessonPage(response) {
  return response.ok && !response.redirected && response.type === "basic" &&
    (response.headers.get("Content-Type") || "").includes("text/html")
}

async function savedPage(path) {
  return (await caches.open(PAGES)).match(path, { ignoreVary: true })
}

async function saveIfStale(path) {
  const cache = await caches.open(PAGES)
  const entry = (await readIndex(cache)).find((e) => e.path === path)
  if (entry && Date.now() - Date.parse(entry.saved_at) < 60 * 1000) return
  const started = generation
  try {
    const response = await fetch(path, { credentials: "same-origin", headers: { Accept: "text/html" } })
    if (isLessonPage(response)) await savePage(path, response, started)
  } catch (error) {}
}

async function savePage(path, response, started) {
  const html = await response.clone().text()
  return queuePages(async () => {
    if (started !== generation) return
    const cache = await caches.open(PAGES)
    await cache.put(path, response)
    const index = (await readIndex(cache)).filter((entry) => entry.path !== path)
    index.unshift({ path, title: lessonTitle(html), saved_at: new Date().toISOString() })
    const keep = index.slice(0, MAX_PAGES)
    await cache.put(INDEX_URL, new Response(JSON.stringify(keep), { headers: { "Content-Type": "application/json" } }))
    // Evict by what is actually stored, so nothing outlives the index.
    const kept = new Set(keep.map((entry) => entry.path).concat(INDEX_URL))
    for (const request of await cache.keys()) {
      if (!kept.has(new URL(request.url).pathname)) await cache.delete(request)
    }
  })
}

async function readIndex(cache) {
  const hit = await cache.match(INDEX_URL)
  if (!hit) return []
  try { return await hit.json() } catch (error) { return [] }
}

// The lesson's heading, as plain text. The offline page shows it with
// textContent, never as HTML.
function lessonTitle(html) {
  const match = html.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i)
  if (!match) return ""
  return match[1].replace(/<[^>]*>/g, "")
    .replace(/&#39;|&#x27;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&")
    .replace(/\s+/g, " ").trim().slice(0, 120)
}

async function asset(event, request) {
  const cache = await caches.open(ASSETS)
  const hit = await cache.match(request)
  if (hit) return hit
  const response = await fetch(request)
  if (response.ok && response.type === "basic") event.waitUntil(saveAsset(cache, request, response.clone()))
  return response
}

async function saveAsset(cache, request, response) {
  await cache.put(request, response)
  const keys = await cache.keys()
  for (const old of keys.slice(0, Math.max(0, keys.length - MAX_ASSETS))) await cache.delete(old)
}
