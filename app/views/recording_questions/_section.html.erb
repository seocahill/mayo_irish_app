<%# Questions an editor wrote for this recording, for learners to listen for. Editors add and remove them here. Renders nothing for a learner when there are none. %>
<% if questions.any? || current_user.admin? %>
  <section id="questions" class="card px-4 py-4 flex flex-col gap-3" aria-labelledby="questions-heading">
    <div>
      <h2 id="questions-heading" class="eyebrow text-eist"><%= t(".heading") %></h2>
      <% if questions.any? %>
        <p class="text-sm text-muted mt-1"><%= t(".how_to_use") %></p>
      <% end %>
    </div>

    <% if questions.any? %>
      <ol class="flex flex-col gap-2 list-decimal pl-5">
        <% questions.each.with_index(1) do |q, n| %>
          <li data-testid="recording-question">
            <p id="recording-question-<%= q.id %>" class="break-words"><%= q.question %></p>
            <details>
              <summary class="cursor-pointer text-sm text-muted py-3"><%= t(".show_answer") %><span class="sr-only"><%= t(".to_question", n: n) %></span></summary>
              <p class="text-sm break-words"><%= q.answer %></p>
            </details>
            <% if current_user.admin? %>
              <%= button_to t(".remove"), recording_question_path(q), method: :delete,
                            form: { data: { turbo_confirm: t(".remove_confirm") } },
                            "aria-describedby": "recording-question-#{q.id}",
                            class: "text-xs text-muted underline min-h-11" %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if current_user.admin? %>
      <%= form_with model: RecordingQuestion.new, url: recording_questions_path(recording_id), class: "flex flex-col gap-2 pt-3 border-t border-line" do |f| %>
        <p class="text-xs text-muted"><%= t(".editor_note") %></p>
        <div>
          <%= f.label :question, t(".question"), class: "editor-label" %>
          <%= f.text_area :question, rows: 2, required: true, maxlength: RecordingQuestion::MAX_LENGTH, class: "editor-input" %>
        </div>
        <div>
          <%= f.label :answer, t(".answer"), class: "editor-label" %>
          <%= f.text_area :answer, rows: 2, required: true, maxlength: RecordingQuestion::MAX_LENGTH, class: "editor-input" %>
        </div>
        <div><%= f.submit t(".add"), class: "btn-solid text-sm" %></div>
      <% end %>
    <% end %>
  </section>
<% end %>
