<turbo-frame id="<%= dom_id(@section) %>">
  <%= form_with model: @section do |f| %>
    <div class="border-b border-line px-5 py-4 bg-canvas">
      <label class="editor-label"><%= t(".label") %></label>
      <%= f.text_field :label, class: "editor-input", placeholder: t(".label_placeholder") %>
    </div>
    <div class="px-5 py-4">
      <label class="editor-label mb-2 block"><%= t(".content") %></label>
      <%= f.rich_text_area :body %>
    </div>
    <div class="px-5 py-3 border-t border-line flex items-center justify-between bg-canvas">
      <a href="<%= edit_lesson_path(@section.grammar_rule.lesson) %>"
         data-turbo-frame="<%= dom_id(@section) %>"
         class="text-sm text-muted hover:text-ink transition-colors"><%= t("shared.cancel") %></a>
      <%= f.submit t("shared.save"), class: "btn-solid" %>
    </div>
  <% end %>
</turbo-frame>
