<div class="flex items-center justify-between mb-6">
  <div>
    <div class="text-xs text-stone-400 uppercase tracking-widest mb-1">
      Ceacht <%= @section.grammar_rule.lesson.number %> · <%= @section.grammar_rule.title %>
    </div>
    <h1 class="text-xl font-bold text-stone-800"><%= @section.label.presence || "Réamhrá" %></h1>
  </div>
  <a href="<%= edit_lesson_path(@section.grammar_rule.lesson) %>" class="text-sm text-stone-500 hover:text-stone-800 transition-colors">← Ar ais</a>
</div>

<%= form_with model: @section, class: "bg-white rounded-xl border border-stone-200 overflow-hidden" do |f| %>
  <div class="px-6 py-4 border-b border-stone-100">
    <label class="editor-label">Lipéad</label>
    <%= f.text_field :label, class: "editor-input", placeholder: "(i) Foirmeacha…" %>
  </div>
  <div class="px-6 py-4">
    <label class="editor-label">Ábhar</label>
    <%= f.rich_text_area :body %>
  </div>
  <div class="px-6 py-4 border-t border-stone-100 flex justify-between">
    <a href="<%= edit_lesson_path(@section.grammar_rule.lesson) %>" class="text-stone-500 hover:text-stone-800 text-sm transition-colors">Cealaigh</a>
    <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-6 py-2 rounded-lg font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
