<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= link_to t(".eyebrow"), course_tools_path, class: "hover:underline" %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
  </header>

  <% if @rows.empty? %>
    <p class="card px-4 py-3 text-sm text-muted" id="hard-clips-none"><%= t(".none") %></p>
  <% else %>
    <ol class="flex flex-col gap-3" id="hard-clips">
      <% @rows.each do |row| %>
        <% clip = row.clip %>
        <% item = clip.vocabulary_item %>
        <li class="card px-4 py-3 text-sm" id="hard-clip-<%= clip.id %>">
          <p lang="ga" class="font-semibold"><%= clip.irish %></p>
          <p class="text-muted"><%= clip.english %></p>
          <% speaker = [ clip.speaker_name, clip.speaker_dialect&.humanize ].compact_blank.join(" · ") %>
          <% if speaker.present? %>
            <p class="text-xs text-muted mt-1"><%= speaker %></p>
          <% end %>
          <dl class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-1">
            <div>
              <dt class="text-xs text-muted"><%= t(".not_yet") %></dt>
              <dd class="tabular-nums"><%= t(".not_yet_value", not_yet: row.not_yet, answers: row.answers, percent: row.not_yet_percent) %></dd>
            </div>
            <div>
              <dt class="text-xs text-muted"><%= t(".word") %></dt>
              <dd><span lang="ga"><%= item.irish %></span> <span class="text-muted">· <%= item.english %></span></dd>
            </div>
            <div>
              <dt class="text-xs text-muted"><%= t(".lesson") %></dt>
              <dd><%= link_to item.lesson.display_title, lesson_path(item.lesson), class: "underline" %><% unless item.lesson.published? %> <span class="chip text-[10px]"><%= t(".draft") %></span><% end %></dd>
            </div>
          </dl>
          <p class="mt-1 text-xs flex flex-wrap gap-x-4">
            <%= link_to listening_clip_path(clip), class: "underline inline-flex items-center min-h-12 sm:min-h-0" do %><%= t(".open_clip") %><span class="sr-only"> <%= clip.irish %></span><% end %>
            <%= link_to lesson_listening_clips_path(item.lesson), class: "underline inline-flex items-center min-h-12 sm:min-h-0" do %><%= t(".lesson_clips") %><span class="sr-only"> <%= item.lesson.display_title %></span><% end %>
          </p>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
