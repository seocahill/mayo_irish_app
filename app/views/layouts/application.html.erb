<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>Learn Gaeilge Mhaigh Eo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full bg-stone-50 text-stone-900 font-serif">

    <header class="bg-emerald-900 text-white shadow-sm">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div>
            <div class="font-bold text-lg leading-tight tracking-wide">Learn Gaeilge Mhaigh Eo</div>
            <div class="text-emerald-300 text-xs tracking-widest uppercase">Mayo Irish</div>
          </div>
        </a>
        <nav class="text-sm text-emerald-200 flex items-center gap-3 sm:gap-4">
          <% if authenticated? %>
            <%= form_with url: search_path, method: :get, class: "relative", data: { turbo_frame: "_top" } do |f| %>
              <svg class="w-4 h-4 text-emerald-300 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
              </svg>
              <%= f.search_field :q, value: params[:q], autocomplete: "off",
                    placeholder: "Search…", "aria-label": "Search",
                    class: "w-28 sm:w-44 focus:w-32 sm:focus:w-56 transition-all bg-emerald-800/60 border border-emerald-700 rounded-full pl-8 pr-3 py-1.5 text-sm text-white placeholder-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-emerald-800" %>
            <% end %>
          <% end %>
          <a href="/" class="hover:text-white transition-colors hidden sm:inline">All Lessons</a>
          <% if authenticated? %>
            <span class="text-emerald-400 hidden sm:inline"><%= current_user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "text-emerald-300 hover:text-white transition-colors bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "hover:text-white transition-colors" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <div class="bg-emerald-50 border-b border-emerald-200 text-emerald-800 text-sm text-center py-2 px-4">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 border-b border-red-200 text-red-800 text-sm text-center py-2 px-4">
        <%= alert %>
      </div>
    <% end %>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="mt-16 border-t border-stone-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 py-6 text-center text-stone-400 text-sm">
        Bunaithe ar <em>Learning Irish</em> le Mícheál Ó Siadhail &mdash; arna oiriúnú do Ghaeilge Mhaigh Eo
      </div>
    </footer>

  </body>
</html>
