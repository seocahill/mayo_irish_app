<turbo-frame id="<%= dom_id(lesson_block) %>" class="block">
  <div class="bg-surface rounded-sm border border-line overflow-hidden group">
    <%# Block type badge + actions %>
    <div class="px-5 py-2.5 bg-canvas border-b border-line flex items-center justify-between">
      <span class="text-xs font-semibold text-muted uppercase tracking-wide"><%= t("lesson_blocks.types.#{lesson_block.block_type}") %></span>
      <div class="flex items-center gap-3">
        <span class="text-stone-300 hover:text-muted cursor-grab text-sm transition-colors" data-blocks-handle title="<%= t(".drag_to_reorder") %>">⠿</span>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-3">
          <%= link_to t("shared.edit"), edit_lesson_block_path(lesson_block),
                class: "text-muted hover:text-ink text-xs transition-colors" %>
          <%= button_to t("shared.delete"), lesson_block_path(lesson_block), method: :delete,
                class: "text-muted hover:text-red-500 text-xs transition-colors bg-transparent border-none cursor-pointer",
                data: { turbo_confirm: t("shared.confirm") } %>
        </span>
      </div>
    </div>

    <%# Block content %>
    <div class="px-5 py-4">
      <% if lesson_block.text? %>
        <div class="lexxy-content prose-sm text-ink">
          <%= lesson_block.body %>
        </div>

      <% elsif lesson_block.image? %>
        <% if lesson_block.file.attached? %>
          <figure>
            <%= image_tag lesson_block.file, class: "max-w-full rounded-sm" %>
            <% if lesson_block.caption.present? %>
              <figcaption class="text-xs text-muted mt-2 text-center"><%= lesson_block.caption %></figcaption>
            <% end %>
          </figure>
        <% else %>
          <p class="text-sm text-muted italic"><%= t(".no_image") %></p>
        <% end %>

      <% elsif lesson_block.video? %>
        <% if lesson_block.url.present? && lesson_block.video_embed %>
          <figure>
            <%= render "shared/video", embed: lesson_block.video_embed %>
            <% if lesson_block.caption.present? %>
              <figcaption class="text-xs text-muted mt-2 text-center"><%= lesson_block.caption %></figcaption>
            <% end %>
          </figure>
        <% else %>
          <p class="text-sm text-muted italic"><%= t(".no_video") %></p>
        <% end %>

      <% elsif lesson_block.pdf? %>
        <% if lesson_block.file.attached? %>
          <%= link_to rails_blob_url(lesson_block.file, disposition: "inline"), target: "_blank", class: "block group/pdf" do %>
            <% if lesson_block.file.previewable? %>
              <div class="rounded-sm overflow-hidden border border-line mb-3 bg-stone-50">
                <%= image_tag lesson_block.file.preview(resize_to_limit: [1600, 1200]), class: "w-full object-top object-cover" %>
              </div>
            <% end %>
            <div class="flex items-center gap-3">
              <svg class="w-8 h-8 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
              <div>
                <p class="text-sm font-medium text-ink group-hover/pdf:underline"><%= lesson_block.caption.presence || lesson_block.file.filename %></p>
                <p class="text-xs text-muted"><%= number_to_human_size(lesson_block.file.byte_size) %></p>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-muted italic"><%= t(".no_pdf") %></p>
        <% end %>

      <% elsif lesson_block.audio? %>
        <% if lesson_block.file.attached? %>
          <figure>
            <audio controls src="<%= rails_blob_url(lesson_block.file) %>" class="w-full"></audio>
            <% if lesson_block.caption.present? %>
              <figcaption class="text-xs text-muted mt-2"><%= lesson_block.caption %></figcaption>
            <% end %>
          </figure>
        <% else %>
          <p class="text-sm text-muted italic"><%= t(".no_audio") %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</turbo-frame>
