<turbo-frame id="<%= dom_id(@block) %>">
  <%= form_with model: @block, class: "bg-surface rounded-sm border border-line overflow-hidden" do |f| %>

    <div class="px-5 py-3 bg-stone-100 border-b border-line flex items-center gap-2">
      <span class="text-xs font-semibold text-muted uppercase tracking-wide"><%= @block.block_type %> block</span>
    </div>

    <div class="px-5 py-4 space-y-4">
      <% if @block.text? %>
        <%= f.rich_text_area :body, class: "min-h-[200px]" %>

      <% elsif @block.image? %>
        <% if @block.file.attached? %>
          <div class="mb-3">
            <%= image_tag @block.file, class: "max-h-48 rounded-sm object-cover" %>
          </div>
        <% end %>
        <div>
          <label class="editor-label">Íomhá</label>
          <%= f.file_field :file, accept: "image/*", class: "editor-input" %>
        </div>
        <div>
          <label class="editor-label">Fotheideal (roghnach)</label>
          <%= f.text_area :caption, rows: 3, class: "editor-textarea", placeholder: "Cur síos ar an íomhá..." %>
        </div>

      <% elsif @block.video? %>
        <div>
          <label class="editor-label">URL an Físeáin (YouTube nó Vimeo)</label>
          <%= f.text_area :url, rows: 2, class: "editor-textarea", placeholder: "https://www.youtube.com/watch?v=..." %>
        </div>
        <div>
          <label class="editor-label">Fotheideal (roghnach)</label>
          <%= f.text_area :caption, rows: 3, class: "editor-textarea", placeholder: "Cur síos ar an bhfíseán..." %>
        </div>

      <% elsif @block.pdf? %>
        <% if @block.file.attached? %>
          <div class="mb-3 flex items-center gap-2 text-sm text-ink">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
            <%= @block.file.filename %>
          </div>
        <% end %>
        <div>
          <label class="editor-label">Comhad PDF</label>
          <%= f.file_field :file, accept: ".pdf", class: "editor-input" %>
        </div>
        <div>
          <label class="editor-label">Fotheideal (roghnach)</label>
          <%= f.text_area :caption, rows: 3, class: "editor-textarea", placeholder: "Teideal an doiciméid..." %>
        </div>

      <% elsif @block.audio? %>
        <% if @block.file.attached? %>
          <div class="mb-3">
            <audio controls src="<%= rails_blob_url(@block.file) %>" class="w-full"></audio>
          </div>
        <% end %>
        <div>
          <label class="editor-label">Comhad Fuaime</label>
          <%= f.file_field :file, accept: "audio/*", class: "editor-input" %>
        </div>
        <div>
          <label class="editor-label">Fotheideal (roghnach)</label>
          <%= f.text_area :caption, rows: 3, class: "editor-textarea", placeholder: "Cur síos ar an gcomhad fuaime..." %>
        </div>
      <% end %>
    </div>

    <div class="px-5 py-3 border-t border-line flex items-center justify-between">
      <%= link_to "Cealaigh", edit_lesson_path(@block.lesson),
            class: "text-sm text-muted hover:text-ink transition-colors" %>
      <%= f.submit "Sábháil", class: "btn-solid" %>
    </div>
  <% end %>
</turbo-frame>
