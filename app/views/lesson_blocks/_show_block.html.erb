<% if block.text? %>
  <div class="lexxy-content prose text-ink" data-speakable-target="content">
    <%= speakable_irish(block.body) %>
  </div>

<% elsif block.image? && block.file.attached? %>
  <figure>
    <%= link_to rails_blob_url(block.file, disposition: "inline"), target: "_blank", title: t("lesson_blocks.full_size") do %>
      <%= image_tag block.file, class: "block mx-auto max-w-full h-auto rounded-sm" %>
    <% end %>
    <% if block.caption.present? %>
      <figcaption class="text-sm text-muted mt-2 text-center"><%= block.caption %></figcaption>
    <% end %>
  </figure>

<% elsif block.video? && block.video_embed %>
  <figure>
    <%= render "shared/video", embed: block.video_embed %>
    <% if block.caption.present? %>
      <figcaption class="text-sm text-muted mt-2 text-center"><%= block.caption %></figcaption>
    <% end %>
  </figure>

<% elsif block.embed? && block.embed_origin %>
  <%= render "shared/embed", block: block %>

<% elsif block.pdf? && block.file.attached? %>
  <%= link_to rails_blob_url(block.file, disposition: "inline"), target: "_blank", class: "block group/pdf bg-surface rounded-sm border border-line overflow-hidden" do %>
    <% if block.file.previewable? %>
      <div class="bg-stone-50 border-b border-line">
        <%= image_tag block.file.preview(resize_to_limit: [1600, 1200]), class: "w-full object-top object-cover" %>
      </div>
    <% end %>
    <div class="px-5 py-4 flex items-center gap-4">
      <svg class="w-10 h-10 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 002 2z"/>
      </svg>
      <div>
        <p class="text-sm font-medium text-ink group-hover/pdf:underline"><%= block.caption.presence || block.file.filename %></p>
        <p class="text-xs text-muted mt-0.5"><%= number_to_human_size(block.file.byte_size) %></p>
      </div>
    </div>
  <% end %>

<% elsif block.audio? && block.file.attached? %>
  <figure class="bg-surface rounded-sm border border-line px-5 py-4">
    <audio controls src="<%= rails_blob_url(block.file) %>" class="w-full"></audio>
    <% if block.caption.present? %>
      <figcaption class="text-sm text-muted mt-2"><%= block.caption %></figcaption>
    <% end %>
  </figure>
<% end %>
