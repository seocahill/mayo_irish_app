<%# i18n-tasks-use t(".kinds.genitive") t(".kinds.plural") t(".kinds.recording") %>
<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= t(".eyebrow") %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
    <p id="gap-totals" class="mt-3 text-sm">
      <%= t(".totals", genitive: @totals[:genitive], plural: @totals[:plural], recording: @totals[:recording]) %>
    </p>
  </header>

  <% if @rows.empty? %>
    <p class="text-sm text-muted"><%= t(".empty") %></p>
  <% else %>
    <ul class="flex flex-col gap-3">
      <% @rows.each do |row| %>
        <li class="card px-4 py-3 text-sm" id="gaps-lesson-<%= row.lesson.id %>">
          <p class="font-medium"><%= link_to row.lesson.display_title, edit_lesson_path(row.lesson), class: "underline" %>
            <span class="text-muted text-xs">· <%= t(".count", count: row.items.size) %></span></p>
          <ul class="mt-2 flex flex-col gap-1">
            <% row.items.each do |item| %>
              <li id="gap-item-<%= item.id %>"><span lang="ga"><%= item.irish %></span> <span class="text-muted">· <%= item.english %></span>
                <span class="text-xs text-muted">— <%= t(".lacks") %> <%= row.missing(item).map { |m| t(".kinds.#{m}") }.to_sentence %></span>
                <% if AbairtClient.configured? && (row.missing(item) & %i[plural genitive]).any? %>
                  <%= turbo_frame_tag dom_id(item, :form_suggestions) do %>
                    <%= link_to t(".look_up"), vocabulary_item_form_suggestions_path(item), class: "underline text-xs min-h-12 inline-flex items-center" %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  <% end %>

  <section id="unclassified" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".unclassified_title", count: @unclassified_count) %></h2>
    <p class="text-muted text-sm"><%= t(".unclassified_summary") %></p>
    <% if @unclassified_count.positive? %>
      <details class="card px-4 py-3 text-sm" <%= "open" if params[:page].present? %>>
        <summary class="cursor-pointer min-h-12 flex items-center"><%= t(".unclassified_show", count: @unclassified_count) %></summary>
        <ul class="flex flex-col gap-3 mt-2">
          <% @unclassified.each do |item| %>
            <li id="unclassified-item-<%= item.id %>" class="flex flex-col gap-1">
              <span><span lang="ga"><%= item.irish %></span> <span class="text-muted">· <%= item.english %> · <%= link_to item.lesson.display_title, edit_lesson_path(item.lesson), class: "underline" %></span></span>
              <span class="flex flex-wrap gap-2">
                <% { "noun" => t(".noun"), "other" => t(".not_noun") }.each do |value, label| %>
                  <%= button_to label, vocabulary_item_part_of_speech_path(item), method: :patch, params: { part_of_speech: value, page: @page }, class: "btn-outline min-h-12" %>
                <% end %>
                <%= form_with url: vocabulary_item_part_of_speech_path(item), method: :patch, class: "flex gap-2" do |f| %>
                  <%= hidden_field_tag :page, @page %>
                  <%= select_tag :part_of_speech, options_for_select((VocabularyItem::PARTS_OF_SPEECH - %w[noun other]).map { |k| [t("lessons.parts_of_speech.#{k}"), k] }), class: "vocab-cell-input min-h-12", "aria-label": t(".other_type") %>
                  <%= f.submit t(".set"), class: "btn-outline min-h-12" %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
        <% if @pages > 1 %>
          <nav class="flex gap-4 mt-3" aria-label="<%= t(".pages") %>">
            <%= link_to t(".previous"), vocabulary_gaps_path(page: @page - 1, anchor: "unclassified"), class: "underline" if @page > 1 %>
            <span class="text-muted"><%= t(".page_of", page: @page, pages: @pages) %></span>
            <%= link_to t(".next"), vocabulary_gaps_path(page: @page + 1, anchor: "unclassified"), class: "underline" if @page < @pages %>
          </nav>
        <% end %>
      </details>
    <% end %>
  </section>

  <section id="repeated-words" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".repeats_title") %></h2>
    <p class="text-muted text-sm"><%= t(".repeats_summary") %></p>
    <% if @repeats.empty? %>
      <p class="text-sm text-muted"><%= t(".repeats_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @repeats.each do |repeat| %>
          <li class="card px-4 py-3 text-sm">
            <span lang="ga" class="font-medium"><%= repeat.irish %></span>
            <span class="text-muted">·
              <% repeat.items.each_with_index do |item, i| %><%= ", " if i.positive? %><%= link_to item.lesson.display_title, edit_lesson_path(item.lesson), class: "underline" %> (<%= item.english %>)<% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="silent-lessons" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".silent_title") %></h2>
    <p class="text-muted text-sm"><%= t(".silent_summary") %></p>
    <% if @silent_lessons.empty? %>
      <p class="text-sm text-muted"><%= t(".silent_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @silent_lessons.each do |silent| %>
          <li class="card px-4 py-3 text-sm">
            <%= link_to silent.lesson.display_title, edit_lesson_path(silent.lesson), class: "underline font-medium" %>
            <span class="text-muted">· <%= t(".count", count: silent.count) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="unpractised-lessons" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".unpractised_title") %></h2>
    <p class="text-muted text-sm"><%= t(".unpractised_summary") %></p>
    <% if @unpractised_lessons.empty? %>
      <p class="text-sm text-muted"><%= t(".unpractised_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @unpractised_lessons.each do |row| %>
          <li class="card px-4 py-3 text-sm">
            <%= link_to row.lesson.display_title, edit_lesson_path(row.lesson), class: "underline font-medium" %>
            <span class="text-muted">· <%= t(".count", count: row.count) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="ungrammared-lessons" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".ungrammared_title") %></h2>
    <p class="text-muted text-sm"><%= t(".ungrammared_summary") %></p>
    <% if @ungrammared_lessons.empty? %>
      <p class="text-sm text-muted"><%= t(".ungrammared_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @ungrammared_lessons.each do |row| %>
          <li class="card px-4 py-3 text-sm">
            <%= link_to row.lesson.display_title, edit_lesson_path(row.lesson), class: "underline font-medium" %>
            <span class="text-muted">· <%= t(".count", count: row.count) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="unlistened-lessons" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".unlistened_title") %></h2>
    <p class="text-muted text-sm"><%= t(".unlistened_summary") %></p>
    <% if @unlistened_lessons.empty? %>
      <p class="text-sm text-muted"><%= t(".unlistened_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @unlistened_lessons.each do |row| %>
          <li class="card px-4 py-3 text-sm">
            <%= link_to row.lesson.display_title, edit_lesson_path(row.lesson), class: "underline font-medium" %>
            <span class="text-muted">· <%= t(".count", count: row.count) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="empty-lessons" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".empty_lessons_title") %></h2>
    <p class="text-muted text-sm"><%= t(".empty_lessons_summary") %></p>
    <% if @empty_lessons.empty? %>
      <p class="text-sm text-muted"><%= t(".empty_lessons_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @empty_lessons.each do |lesson| %>
          <li class="card px-4 py-3 text-sm">
            <%= link_to lesson.display_title, edit_lesson_path(lesson), class: "underline font-medium" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="thin-themes" class="flex flex-col gap-3">
    <h2 class="font-display text-2xl"><%= t(".themes_title") %></h2>
    <p class="text-muted text-sm"><%= t(".themes_summary", limit: VocabularyGaps::THIN) %></p>
    <% if @thin_themes.empty? %>
      <p class="text-sm text-muted"><%= t(".themes_empty") %></p>
    <% else %>
      <ul class="flex flex-col gap-2">
        <% @thin_themes.each do |theme| %>
          <li class="card px-4 py-3 text-sm">
            <span class="font-medium"><%= theme.name %></span>
            <span class="text-muted">· <%= t(".theme_count", count: theme.count) %><% if theme.examples.any? %>:
              <% theme.examples.each_with_index do |ga, i| %><%= ", " if i.positive? %><span lang="ga"><%= ga %></span><% end %><% end %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
