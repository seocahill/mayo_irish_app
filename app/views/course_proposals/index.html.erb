<%# i18n-tasks-use t(".decisions.discuss") t(".decisions.defer") t(".decisions.dismiss") t(".decisions.reopen") t(".comment_by") t(".comment_label") t(".comment_save") %>
<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= t(".eyebrow") %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
  </header>

  <section class="card px-4 py-4 flex flex-col gap-2">
    <h2 class="font-medium"><%= t(".idea_title") %></h2>
    <%= form_with url: course_proposals_path, method: :post, class: "flex flex-col gap-2" do |f| %>
      <%= f.label :raw_text, t(".idea_label"), class: "text-sm text-muted" %>
      <%= f.text_area :raw_text, rows: 3, maxlength: 2000, placeholder: t(".idea_placeholder"),
            class: "rounded-sm border border-line bg-surface px-3 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-ink" %>
      <%= f.button t(".idea_save"), class: "btn-solid self-start" %>
    <% end %>
  </section>

  <% if @proposals.empty? %>
    <p class="text-sm text-muted" id="no-proposals"><%= t(".empty") %></p>
  <% else %>
    <ul class="flex flex-col gap-3" id="proposals">
      <% @proposals.each do |p| %>
        <li id="proposal-<%= p.id %>" class="card px-4 py-3 flex flex-col gap-1 text-sm">
          <p class="font-medium"><%= p.title %></p>
          <p class="text-xs text-muted"><%= t(".kinds.#{p.kind}") %> · <%= t(".statuses.#{p.status}") %> · <%= t(".origin", origin: p.origin) %></p>
          <% if p.raw_text.present? && p.raw_text != p.title %><p class="whitespace-pre-line"><%= p.raw_text %></p><% end %>
          <% if p.rationale.present? %><p><%= p.rationale %></p><% end %>
          <% if p.decided_by.present? %><p class="text-xs text-muted"><%= t(".decided", by: p.decided_by, date: l(p.decided_at.to_date, format: :long)) %></p><% end %>
          <div class="flex flex-wrap gap-2 pt-1">
            <% p.decisions.each do |d| %>
              <%= button_to t(".decisions.#{d}"), course_proposal_path(p), method: :patch, params: { decision: d },
                    class: "btn-outline min-h-12 px-4 text-sm" %>
            <% end %>
          </div>
          <% if p.proposal_comments.any? %>
            <ul class="flex flex-col gap-2 pt-2 border-t border-line" id="comments-<%= p.id %>">
              <% p.proposal_comments.each do |c| %>
                <li>
                  <p class="text-xs text-muted"><%= t(".comment_by", author: c.author, date: l(c.created_at.to_date, format: :long)) %></p>
                  <p class="whitespace-pre-line"><%= c.body %></p>
                </li>
              <% end %>
            </ul>
          <% end %>
          <%= form_with url: course_proposal_comments_path(p), method: :post, class: "flex flex-col gap-2 pt-2" do |f| %>
            <%= f.label :body, t(".comment_label"), for: "comment-body-#{p.id}", class: "text-xs text-muted" %>
            <%= f.text_area :body, id: "comment-body-#{p.id}", rows: 2, maxlength: 2000,
                  class: "rounded-sm border border-line bg-surface px-3 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-ink" %>
            <%= f.button t(".comment_save"), class: "btn-outline min-h-12 px-4 text-sm self-start" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
