<div class="max-w-2xl mx-auto flex flex-col gap-6">
  <header>
    <p class="eyebrow"><%= link_to t(".eyebrow"), course_tools_path, class: "hover:underline" %></p>
    <h1 class="font-display text-3xl leading-tight"><%= t(".title") %></h1>
    <p class="text-muted mt-1 text-sm"><%= t(".summary") %></p>
    <% if @total.positive? %>
      <p class="mt-2 text-sm tabular-nums" id="learner-questions-count"><%= t(".count", answered: @answered, total: @total) %></p>
    <% end %>
  </header>

  <% if @questions.empty? %>
    <p class="card px-4 py-3 text-sm text-muted" id="learner-questions-none"><%= t(".none") %></p>
  <% else %>
    <% status_labels = { "answered" => t(".status.answered"), "sent" => t(".status.sent"), "waiting" => t(".status.waiting") } %>
    <ul class="flex flex-col gap-3" id="learner-questions">
      <% @questions.each do |question| %>
        <li class="card px-4 py-4 flex flex-col gap-3 text-sm" id="<%= dom_id(question) %>">
          <div class="flex flex-wrap items-baseline justify-between gap-2 text-xs text-muted">
            <span>
              <%= t(".asked_ago", time: time_ago_in_words(question.created_at)) %>
              <% if question.lesson %>
                · <%= link_to question.lesson.display_title, lesson_path(question.lesson), class: "underline underline-offset-2 hover:text-ink" %>
              <% else %>
                · <%= t(".no_lesson") %>
              <% end %>
            </span>
            <span class="chip <%= 'border-eist text-eist' if question.answered? %>"><%= status_labels.fetch(question.status) %></span>
          </div>
          <% if question.audio_url.to_s.start_with?("https://") %>
            <div>
              <p class="eyebrow mb-1"><%= t(".question") %></p>
              <audio controls preload="none" src="<%= question.audio_url %>" class="h-8 w-full max-w-xs"></audio>
            </div>
          <% end %>
          <% if question.answered? && question.answer_audio_url.to_s.start_with?("https://") %>
            <div>
              <p class="eyebrow mb-1 text-eist"><%= t(".answer") %></p>
              <audio controls preload="none" src="<%= question.answer_audio_url %>" class="h-8 w-full max-w-xs"></audio>
            </div>
          <% end %>
          <% ideas = question.ideas %>
          <% if ideas.any? %>
            <p class="text-xs text-muted" id="<%= dom_id(question, :ideas) %>">
              <%= t(".ideas_saved") %>
              <% ideas.each_with_index do |idea, i| %><%= ", " if i.positive? %><%= link_to idea.title, course_proposals_path(anchor: "proposal-#{idea.id}"), class: "underline underline-offset-2 hover:text-ink" %><% end %>
            </p>
          <% end %>
          <details class="border-t border-line pt-2">
            <summary class="cursor-pointer min-h-12 sm:min-h-0 flex items-center text-sm"><%= ideas.any? ? t(".save_another_idea") : t(".save_idea") %></summary>
            <%= form_with url: learner_question_idea_path(question), method: :post, class: "mt-2 flex flex-col gap-2" do |f| %>
              <%= f.label :raw_text, t(".idea_label"), for: dom_id(question, :raw_text), class: "text-xs text-muted" %>
              <%= f.text_area :raw_text, id: dom_id(question, :raw_text), rows: 3, maxlength: 2000, required: true,
                    class: "rounded-sm border border-line bg-surface px-3 py-2.5 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-ink" %>
              <%= f.button t(".idea_save"), class: "btn-solid self-start" %>
            <% end %>
          </details>
        </li>
      <% end %>
    </ul>
    <% if @total > @questions.size %>
      <p class="text-xs text-muted"><%= t(".showing", shown: @questions.size, total: @total) %></p>
    <% end %>
  <% end %>
</div>
