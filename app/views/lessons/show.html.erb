<div class="flex items-center justify-between mb-8">
  <div>
    <div class="text-sm text-stone-400 uppercase tracking-widest mb-1">Ceacht <%= @lesson.number %></div>
    <h1 class="text-3xl font-bold text-stone-800"><%= @lesson.title %></h1>
  </div>
  <a href="<%= edit_lesson_path(@lesson) %>"
     class="inline-flex items-center gap-2 text-sm bg-emerald-800 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
    </svg>
    Cuir in eagar
  </a>
</div>

<%# ── VOCABULARY ─────────────────────────────────────────────── %>
<% if @lesson.vocabulary_items.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading">Stór Focal</h2>

    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-stone-50 border-b border-stone-200 text-stone-500 text-xs uppercase tracking-wide">
            <th class="text-left px-4 py-3 font-medium">Gaeilge</th>
            <th class="text-left px-4 py-3 font-medium hidden sm:table-cell">Fuaimniú</th>
            <th class="text-left px-4 py-3 font-medium hidden md:table-cell">Iolra</th>
            <th class="text-left px-4 py-3 font-medium">Béarla</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @lesson.vocabulary_items.each do |item| %>
            <tr class="hover:bg-stone-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-emerald-900">
                <%= item.irish %>
                <% if item.gender == 'f' %>
                  <span class="text-xs text-stone-400 font-normal ml-1">bain.</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-stone-500 font-mono text-xs hidden sm:table-cell">
                <% if item.phonetic.present? %>/<%= item.phonetic %>/<% end %>
              </td>
              <td class="px-4 py-3 text-stone-600 hidden md:table-cell"><%= item.plural %></td>
              <td class="px-4 py-3 text-stone-700"><%= item.english %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @lesson.vocabulary_notes.present? %>
      <div class="mt-3 bg-amber-50 border border-amber-200 rounded-lg px-5 py-4 text-sm text-stone-700 prose prose-sm max-w-none">
        <p class="font-semibold text-amber-800 mb-1 text-xs uppercase tracking-wide">Nóta Focail</p>
        <%= simple_format @lesson.vocabulary_notes %>
      </div>
    <% end %>
  </section>
<% end %>

<%# ── GRAMMAR ─────────────────────────────────────────────────── %>
<% grammar_rows = @lesson.lesson_rows.for_section('grammar') %>
<% if grammar_rows.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading">Gramadach</h2>
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-stone-50 border-b border-stone-200 text-stone-500 text-xs uppercase tracking-wide">
            <th class="text-right px-4 py-3 font-medium w-8">#</th>
            <th class="text-left px-4 py-3 font-medium w-[28%]">Riail</th>
            <th class="text-left px-4 py-3 font-medium">Míniú</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% grammar_rows.each do |row| %>
            <tr class="hover:bg-stone-50 transition-colors align-top">
              <td class="px-4 py-3 text-stone-400 font-mono text-xs text-right select-none"><%= row.position %>.</td>
              <td class="px-4 py-3 font-semibold text-emerald-900 text-xs uppercase tracking-wide leading-snug"><%= row.col_1 %></td>
              <td class="px-4 py-3 text-stone-700 whitespace-pre-wrap leading-relaxed"><%= row.col_2 %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%# ── TEXTS ──────────────────────────────────────────────────── %>
<% text_rows = @lesson.lesson_rows.for_section('texts') %>
<% if text_rows.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading">Téacsanna</h2>
    <div class="bg-white rounded-xl border border-stone-200 px-6 py-5">
      <% text_rows.each do |row| %>
        <p class="text-stone-800 leading-relaxed mb-2 last:mb-0"><%= row.col_1 %></p>
      <% end %>
    </div>
  </section>
<% end %>

<%# ── EXERCISES ────────────────────────────────────────────────── %>
<% exercise_rows = @lesson.lesson_rows.for_section('exercises') %>
<% if exercise_rows.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading">Cleachtaí</h2>
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          <% exercise_rows.each do |row| %>
            <tr class="hover:bg-stone-50 transition-colors">
              <td class="px-4 py-3 text-stone-400 font-mono text-xs text-right align-top select-none w-8"><%= row.position %>.</td>
              <td class="px-4 py-3 text-stone-700"><%= row.col_1 %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%# ── NAV ─────────────────────────────────────────────────────── %>
<div class="flex justify-between items-center mt-12 pt-6 border-t border-stone-200">
  <div>
    <% if @lesson.previous_lesson %>
      <a href="<%= lesson_path(@lesson.previous_lesson) %>" class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-emerald-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Ceacht <%= @lesson.previous_lesson.number %>
      </a>
    <% end %>
  </div>
  <a href="<%= root_path %>" class="text-sm text-stone-400 hover:text-stone-700 transition-colors">Gach Ceacht</a>
  <div>
    <% if @lesson.next_lesson %>
      <a href="<%= lesson_path(@lesson.next_lesson) %>" class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-emerald-800 transition-colors">
        Ceacht <%= @lesson.next_lesson.number %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    <% end %>
  </div>
</div>
