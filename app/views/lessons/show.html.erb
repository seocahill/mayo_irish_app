<% level = level_classes(lesson_level(@lesson)) %>
<header class="flex flex-col gap-5 mb-8">
  <div class="min-w-0">
    <p class="eyebrow <%= level[:text] %>">Ceacht <%= @lesson.number %> · <%= @lesson.type_label %></p>
    <h1 class="text-3xl sm:text-4xl font-display text-ink leading-tight break-words mt-1"><%= @lesson.title %></h1>
    <% if @lesson.content_html.present? %>
      <p class="text-sm text-muted mt-2 italic"><%= @lesson.content_html %></p>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if @lesson.vocabulary_items.any? %>
      <%= link_to "Triail", lesson_quiz_path(@lesson), class: "btn-solid flex-1 sm:flex-initial" %>
    <% end %>
    <%= link_to "Cleachtadh", lesson_chat_path(@lesson), class: "btn-outline flex-1 sm:flex-initial" %>
    <% if current_user&.admin? %>
      <%= link_to "Cuir in eagar", edit_lesson_path(@lesson), class: "btn-outline flex-1 sm:flex-initial border-line text-muted" %>
    <% end %>
  </div>
</header>

<% if current_user && @quiz_progress.any? %>
  <div class="mb-8">
    <%= render "shared/progress_bar", progress: @quiz_progress, label: "Stór focal ar eolas" %>
  </div>
<% end %>

<%# ── CONTENT BLOCKS ──────────────────────────────────────────── %>
<% if @lesson.lesson_blocks.any? %>
  <section class="mb-10 space-y-4">
    <% @lesson.lesson_blocks.each do |block| %>
      <%= render "lesson_blocks/show_block", block: block %>
    <% end %>
  </section>
<% end %>

<%# ── VOCABULARY ─────────────────────────────────────────────── %>
<% if @lesson.vocabulary_items.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading flex items-center gap-2">
      Stór Focal
      <%= render "section_badge", section: "vocabulary", progress: @section_progress %>
    </h2>
    <div class="card overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line eyebrow">
            <th class="text-left px-4 py-3 font-normal">Gaeilge</th>
            <th class="text-left px-4 py-3 font-normal hidden sm:table-cell">Fuaimniú</th>
            <th class="text-left px-4 py-3 font-normal hidden md:table-cell">Iolra</th>
            <th class="text-left px-4 py-3 font-normal">Béarla</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @lesson.vocabulary_items.each do |item| %>
            <tr class="hover:bg-canvas transition-colors">
              <td class="px-4 py-3 font-semibold text-ink">
                <%= item.irish %>
                <% if item.gender == 'f' %>
                  <span class="text-xs text-muted font-normal ml-1">bain.</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-muted font-mono text-xs hidden sm:table-cell">
                <% if item.phonetic.present? %>/<%= item.phonetic %>/<% end %>
              </td>
              <td class="px-4 py-3 text-ink hidden md:table-cell"><%= item.plural %></td>
              <td class="px-4 py-3 text-ink"><%= item.english %></td>
              <td class="px-2 sm:px-4 py-3">
                <div class="flex items-center gap-2 sm:gap-3 justify-end">
                  <% if item.audio.attached? %>
                    <audio controls src="<%= rails_blob_url(item.audio) %>" class="h-8 w-28 sm:w-40"></audio>
                  <% elsif item.audio_url.present? %>
                    <audio controls src="<%= item.audio_url %>" class="h-8 w-28 sm:w-40"></audio>
                  <% end %>

                  <% if item.audio.attached? || item.audio_url.present? %>
                    <div data-controller="recorder" class="flex items-center gap-1.5" title="Taifead tú féin">
                      <button type="button"
                              data-recorder-target="recordButton"
                              data-action="recorder#toggle"
                              class="text-muted hover:text-red-600 transition-colors"
                              aria-label="Taifead">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-14 0m7 7v4m0-4a3 3 0 01-3-3V5a3 3 0 016 0v6a3 3 0 01-3 3z"/>
                        </svg>
                      </button>
                      <button type="button"
                              data-recorder-target="playButton"
                              data-action="recorder#play"
                              disabled
                              class="text-muted hover:text-ink transition-colors disabled:opacity-30 disabled:hover:text-muted"
                              aria-label="Seinn an taifeadadh agat">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </button>
                      <span data-recorder-target="status" class="text-xs text-muted w-16 hidden sm:inline"></span>
                    </div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @lesson.vocabulary_notes_content.present? && @lesson.vocabulary_notes_content.to_plain_text.present? %>
      <div class="mt-3 bg-eist/10 border border-eist/30 rounded-sm px-5 py-4 text-sm text-ink">
        <p class="eyebrow text-eist mb-2">Nótaí focail</p>
        <%= @lesson.vocabulary_notes_content %>
      </div>
    <% end %>
  </section>
<% end %>

<%# ── GRAMMAR ─────────────────────────────────────────────────── %>
<% if @lesson.grammar_rules.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading flex items-center gap-2">
      Gramadach
      <%= render "section_badge", section: "grammar", progress: @section_progress %>
    </h2>
    <div class="space-y-6">
      <% @lesson.grammar_rules.each do |rule| %>
        <div class="card overflow-hidden">
          <div class="border-b border-line px-5 py-4 flex items-baseline gap-3">
            <span class="font-mono text-sm text-muted tabular-nums"><%= rule.number %></span>
            <span class="font-display text-lg leading-snug"><%= rule.title %></span>
          </div>
          <% if rule.body.present? && rule.body.to_plain_text.present? %>
            <div class="px-5 py-4 text-sm text-ink prose prose-sm max-w-none border-b border-line">
              <%= rule.body %>
            </div>
          <% end %>
          <% rule.grammar_sections.each do |section| %>
            <div class="border-b border-line last:border-0">
              <% if section.label.present? %>
                <div class="px-5 py-2 bg-canvas eyebrow">
                  <%= section.label %>
                </div>
              <% end %>
              <div class="px-5 py-4 text-sm prose prose-sm max-w-none lesson-grammar-content">
                <%= section.body %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<%# ── TEXTS ──────────────────────────────────────────────────── %>
<% if @lesson.text_passages.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading flex items-center gap-2">
      Téacsanna
      <%= render "section_badge", section: "texts", progress: @section_progress %>
    </h2>
    <% @lesson.text_passages.each do |passage| %>
      <div class="card overflow-hidden mb-4 last:mb-0">
        <% if passage.title.present? %>
          <div class="border-b border-line px-5 py-3 font-display text-lg">
            <%= passage.title %>
          </div>
        <% end %>
        <div class="px-5 py-4 text-sm prose prose-sm max-w-none leading-relaxed">
          <%= passage.body %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<%# ── EXERCISES ────────────────────────────────────────────────── %>
<% if @lesson.exercises.any? %>
  <section class="mb-10">
    <h2 class="lesson-section-heading flex items-center gap-2">
      Cleachtaí
      <%= render "section_badge", section: "exercises", progress: @section_progress %>
    </h2>
    <div class="card overflow-hidden">
      <ol class="divide-y divide-line list-none">
        <% @lesson.exercises.each do |ex| %>
          <li class="flex gap-4 px-5 py-3 hover:bg-canvas transition-colors">
            <span class="font-mono text-xs text-muted w-6 shrink-0 pt-0.5 tabular-nums"><%= ex.number %></span>
            <span class="text-sm"><%= ex.prompt %></span>
          </li>
        <% end %>
      </ol>
    </div>
  </section>
<% end %>

<%# ── NAV ─────────────────────────────────────────────────────── %>
<div class="flex justify-between items-center mt-12 pt-6 border-t border-line">
  <div>
    <% if @lesson.previous_lesson %>
      <a href="<%= lesson_path(@lesson.previous_lesson) %>" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Ceacht <%= @lesson.previous_lesson.number %>
      </a>
    <% end %>
  </div>
  <a href="<%= lessons_path %>" class="text-sm text-muted hover:text-ink transition-colors">Gach ceacht</a>
  <div>
    <% if @lesson.next_lesson %>
      <a href="<%= lesson_path(@lesson.next_lesson) %>" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
        Ceacht <%= @lesson.next_lesson.number %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    <% end %>
  </div>
</div>
