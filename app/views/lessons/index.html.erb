<div class="flex items-start justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-stone-800 mb-2">Cúrsa Gaeilge Mhaigh Eo</h1>
    <p class="text-stone-500 text-lg"><%= @lessons.count %> ceacht · Bunaithe ar chanúint Mhaigh Eo</p>
  </div>
  <%= link_to new_lesson_path, class: "inline-flex items-center gap-2 text-sm bg-emerald-800 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors mt-1" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
    Ceacht Nua
  <% end %>
</div>

<div class="grid gap-2">
  <% @lessons.each do |lesson| %>
    <div class="bg-white rounded-lg border border-stone-200 hover:border-emerald-400 hover:shadow-sm transition-all group">
      <div class="flex items-center justify-between px-5 py-4">
        <a href="<%= lesson_path(lesson) %>" class="flex items-center gap-4 flex-1 min-w-0">
          <span class="flex-shrink-0 w-9 h-9 rounded-full bg-emerald-50 text-emerald-800 text-sm font-bold flex items-center justify-center border border-emerald-200 group-hover:bg-emerald-800 group-hover:text-white group-hover:border-emerald-800 transition-all">
            <%= lesson.number %>
          </span>
          <div class="min-w-0">
            <div class="font-semibold text-stone-800 truncate group-hover:text-emerald-900"><%= lesson.title %></div>
            <div class="text-xs text-stone-400 mt-0.5">
              <%= lesson.vocabulary_items.count %> focal
              <% if lesson.grammar.present? %> · Gramadach<% end %>
              <% if lesson.texts.present? %> · Téacs<% end %>
            </div>
          </div>
        </a>
        <a href="<%= edit_lesson_path(lesson) %>" class="ml-4 flex-shrink-0 text-xs text-stone-300 hover:text-emerald-600 transition-colors px-2 py-1 rounded hover:bg-emerald-50">
          Cuir in eagar
        </a>
      </div>
    </div>
  <% end %>
</div>
