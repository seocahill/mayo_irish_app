<div class="flex flex-col gap-10">

  <header class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Cúrsa</p>
      <h1 class="font-display text-3xl leading-tight">Gaeilge Mhaigh Eo</h1>
      <p class="text-muted mt-1"><%= @lessons.count %> ceacht · Bunaithe ar chanúint Mhaigh Eo</p>
    </div>
    <% if current_user&.admin? %>
      <%= link_to "Ceacht nua", new_lesson_path, class: "btn-solid shrink-0" %>
    <% end %>
  </header>

  <%
    sections = [
      { key: "curriculum",     label: "Learning Irish",        desc: "Core grammar and conversation curriculum" },
      { key: "thematic_vocab", label: "Mayo Irish vocabulary", desc: "Thematic word lists with audio" },
      { key: "dias_material",  label: "DIAS field recordings", desc: "Foxford and Erris dialect notes (Wagner)" },
    ]
    by_type = @lessons.group_by(&:lesson_type)
  %>

  <% sections.each do |section| %>
    <% group = by_type[section[:key]] %>
    <% next if group.blank? %>

    <section class="flex flex-col gap-3">
      <div>
        <h2 class="eyebrow"><%= section[:label] %></h2>
        <p class="text-sm text-muted"><%= section[:desc] %></p>
      </div>

      <ul class="card divide-y divide-line">
        <% group.each do |lesson| %>
          <% lp = @quiz_progress&.fetch(lesson.id, nil) %>
          <% level = level_classes(lesson_level(lesson)) %>
          <li class="flex items-stretch hover:bg-canvas transition-colors">
            <a href="<%= lesson_path(lesson) %>" class="flex-1 min-w-0 grid grid-cols-[6px_2rem_1fr_auto] items-center gap-3 pl-4 pr-3 py-4">
              <span class="self-stretch rounded-sm <%= level[:stripe] %>" aria-hidden="true"></span>
              <span class="font-mono text-sm text-muted tabular-nums"><%= lesson.number %></span>
              <span class="min-w-0">
                <span class="block leading-snug">
                  <%= lesson.title %>
                  <% unless lesson.published? %>
                    <span class="chip border-labhair text-labhair ml-1 align-middle">Draft</span>
                  <% end %>
                </span>
                <span class="block font-mono text-[11px] uppercase tracking-wider text-muted mt-0.5">
                  <%= lesson.vocabulary_items.size %> focal<% if lesson.grammar.present? %> · Gramadach<% end %><% if lesson.texts.present? %> · Téacs<% end %>
                </span>
              </span>
              <% if lp&.started? %>
                <span class="flex items-center gap-2" title="<%= lp.known %>/<%= lp.total %> focal ar eolas">
                  <% if lp.complete? %>
                    <span class="<%= level[:text] %>" aria-label="Críochnaithe">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    </span>
                  <% else %>
                    <span class="meter w-14 hidden sm:block"><span class="block h-full <%= level[:stripe] %>" style="width: <%= lp.pct %>%"></span></span>
                    <span class="font-mono text-xs text-muted tabular-nums"><%= lp.pct %>%</span>
                  <% end %>
                </span>
              <% else %>
                <span></span>
              <% end %>
            </a>
            <% if current_user&.admin? %>
              <a href="<%= edit_lesson_path(lesson) %>" class="eyebrow self-center px-4 hover:text-ink">Cuir in eagar</a>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
