<div class="flex flex-col gap-10">

  <header class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow"><%= t(".course") %></p>
      <h1 class="font-display text-3xl leading-tight"><%= t("app_name") %></h1>
      <p class="text-muted mt-1"><%= t(".summary", count: @lessons.count) %></p>
    </div>
    <% if current_user&.admin? %>
      <div class="flex flex-wrap justify-end gap-2 shrink-0">
        <% if @flagged_count.positive? %>
          <%= link_to t(".flagged_replies", count: @flagged_count), flagged_replies_path, class: "btn-outline border-labhair text-labhair" %>
        <% end %>
        <%= link_to t(".new_lesson"), new_lesson_path, class: "btn-solid" %>
      </div>
    <% end %>
  </header>

  <% by_type = @lessons.group_by(&:lesson_type) %>

  <% %w[curriculum thematic_vocab dias_material].each do |type| %>
    <% group = by_type[type] %>
    <% next if group.blank? %>

    <section class="flex flex-col gap-3">
      <div>
        <h2 class="eyebrow"><%= t(".sections.#{type}.label") %></h2>
        <p class="text-sm text-muted"><%= t(".sections.#{type}.description") %></p>
      </div>

      <ul class="card divide-y divide-line">
        <% group.each do |lesson| %>
          <% lp = @quiz_progress&.fetch(lesson.id, nil) %>
          <% level = level_classes(lesson_level(lesson)) %>
          <li class="flex items-stretch hover:bg-canvas transition-colors">
            <a href="<%= lesson_path(lesson) %>" class="flex-1 min-w-0 grid grid-cols-[6px_2rem_1fr_auto] items-center gap-3 pl-4 pr-3 py-4">
              <span class="self-stretch rounded-sm <%= level[:stripe] %>" aria-hidden="true"></span>
              <span class="font-mono text-sm text-muted tabular-nums"><%= lesson.number %></span>
              <span class="min-w-0">
                <span class="block leading-snug">
                  <%= lesson.title %>
                  <% unless lesson.published? %>
                    <span class="chip border-labhair text-labhair ml-1 align-middle"><%= t(".draft") %></span>
                    <% if current_user&.admin? && lesson.needs_review? %>
                      <span class="chip border-eist text-eist ml-1 align-middle"><%= t(".needs_review") %></span>
                    <% end %>
                  <% end %>
                </span>
                <span class="block font-mono text-[11px] uppercase tracking-wider text-muted mt-0.5">
                  <%= t(".word_count", count: lesson.vocabulary_items.size) %><% if lesson.grammar.present? %> · <%= t(".grammar") %><% end %>
                </span>
              </span>
              <% if lp&.started? %>
                <span class="flex items-center gap-2" title="<%= t(".progress_title", known: lp.known, total: lp.total) %>">
                  <% if lp.complete? %>
                    <span class="<%= level[:text] %>" aria-label="<%= t(".complete") %>">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    </span>
                  <% else %>
                    <span class="meter w-14 hidden sm:block"><span class="block h-full <%= level[:stripe] %>" style="width: <%= lp.pct %>%"></span></span>
                    <span class="font-mono text-xs text-muted tabular-nums"><%= lp.pct %>%</span>
                  <% end %>
                </span>
              <% else %>
                <span></span>
              <% end %>
            </a>
            <% if current_user&.admin? %>
              <a href="<%= edit_lesson_path(lesson) %>" class="eyebrow self-center px-4 hover:text-ink"><%= t("shared.edit") %></a>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
