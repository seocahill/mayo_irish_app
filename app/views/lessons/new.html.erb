<div class="max-w-lg">
  <div class="mb-6">
    <div class="text-sm text-stone-400 uppercase tracking-widest mb-1">Ceacht Nua</div>
    <h1 class="text-2xl font-display text-ink">Ceacht a chur leis</h1>
  </div>

  <%= form_with model: @lesson, class: "bg-white rounded-xl border border-stone-200 px-6 py-5 space-y-4" do |f| %>
    <div>
      <label class="editor-label">Uimhir an Cheachta</label>
      <%= f.number_field :number, class: "editor-input", placeholder: "e.g. 0", min: 0 %>
    </div>
    <div>
      <label class="editor-label">Teideal</label>
      <%= f.text_field :title, class: "editor-input", placeholder: "e.g. Cúlra: Gaeilge Mhaigh Eo", autofocus: true %>
    </div>
    <div>
      <label class="editor-label">Suíomh (position)</label>
      <%= f.number_field :position, class: "editor-input", min: 0 %>
      <p class="text-xs text-stone-400 mt-1">Ceacht 0 = <%= Lesson.maximum(:position).to_i + 1 %> faoi láthair</p>
    </div>
    <div class="flex items-center justify-between pt-2">
      <%= link_to "Cealaigh", lessons_path, class: "text-sm text-stone-500 hover:text-stone-700 transition-colors" %>
      <%= f.submit "Cruthaigh Ceacht", class: "bg-emerald-800 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
