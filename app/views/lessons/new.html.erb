<div class="max-w-lg">
  <div class="mb-6">
    <div class="text-sm text-muted uppercase tracking-widest mb-1">New lesson</div>
    <h1 class="text-2xl font-display text-ink">Add a lesson</h1>
  </div>

  <%= form_with model: @lesson, class: "bg-surface rounded-sm border border-line px-6 py-5 space-y-4" do |f| %>
    <div>
      <label class="editor-label">Uimhir an Cheachta</label>
      <%= f.number_field :number, class: "editor-input", placeholder: "e.g. 0", min: 0 %>
    </div>
    <div>
      <label class="editor-label">Teideal</label>
      <%= f.text_field :title, class: "editor-input", placeholder: "e.g. Lesson title", autofocus: true %>
    </div>
    <div>
      <label class="editor-label">Position</label>
      <%= f.number_field :position, class: "editor-input", min: 0 %>
      <p class="text-xs text-muted mt-1">Next free position: <%= Lesson.maximum(:position).to_i + 1 %></p>
    </div>
    <div class="flex items-center justify-between pt-2">
      <%= link_to "Cealaigh", lessons_path, class: "text-sm text-muted hover:text-ink transition-colors" %>
      <%= f.submit "Create lesson", class: "btn-solid" %>
    </div>
  <% end %>
</div>
