<% hits = DialectSubstitution.hits_in(lesson) %>
<% if hits.any? %>
  <section class="mb-8 card px-5 py-4" aria-labelledby="dialect-hits-heading">
    <h2 id="dialect-hits-heading" class="eyebrow"><%= t("dialect_substitutions.hits.title") %></h2>
    <p class="text-xs text-muted mt-1"><%= t("dialect_substitutions.hits.summary") %></p>
    <ul class="mt-3 flex flex-col gap-2 text-sm">
      <% hits.each do |hit| %>
        <li>
          <span lang="ga"><%= hit.substitution.other_form %></span> → <strong lang="ga"><%= hit.substitution.mayo_form %></strong>
          <span class="text-muted">· <%= hit.place %></span>
          <% if hit.path %><%= link_to t("dialect_substitutions.hits.open"), hit.path, class: "underline ml-1" %><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
