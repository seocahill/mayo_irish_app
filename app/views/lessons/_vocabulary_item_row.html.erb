<tr class="border-b border-line hover:bg-stone-50 vocab-row">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy, class: "destroy-flag" %>
  <td class="px-2 py-1.5">
    <%= f.text_field :irish, class: "vocab-cell-input", placeholder: "focal" %>
  </td>
  <td class="px-2 py-1.5">
    <%= f.text_field :phonetic, class: "vocab-cell-input font-mono text-xs", placeholder: "/fuaimniú/" %>
  </td>
  <td class="px-2 py-1.5">
    <%= f.text_field :plural, class: "vocab-cell-input", placeholder: "iolra" %>
  </td>
  <td class="px-2 py-1.5">
    <%= f.select :gender,
          [["fir.", "m"], ["bain.", "f"]],
          {},
          class: "vocab-cell-input" %>
  </td>
  <td class="px-2 py-1.5">
    <%= f.text_field :english, class: "vocab-cell-input", placeholder: "meaning" %>
  </td>
  <td class="px-2 py-1.5 text-center">
    <button type="button" data-action="click->vocab-editor#removeRow"
            class="text-stone-300 hover:text-red-500 transition-colors text-lg leading-none"
            title="Scrios">×</button>
  </td>
</tr>
