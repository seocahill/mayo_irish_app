<%# locals: (f:, section:, heading:, col1_label:, col2_label: nil, col3_label: nil) %>
<% col_count = [col1_label, col2_label, col3_label].compact.size %>
<% section_rows = f.object.lesson_rows.for_section(section) %>

<div class="bg-surface rounded-sm border border-line mb-6 overflow-hidden"
     data-controller="row-editor"
     data-row-editor-section-value="<%= section %>">
  <div class="px-6 py-4 border-b border-line flex items-center justify-between">
    <h2 class="font-bold text-ink"><%= heading %></h2>
    <button type="button"
            data-action="click->row-editor#addRow"
            class="text-sm bg-ink text-white px-3 py-1.5 rounded-sm hover:opacity-90 transition-colors">
      + Ró nua
    </button>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-stone-50 border-b border-line text-muted text-xs uppercase tracking-wide">
          <th class="text-left px-3 py-2 font-medium w-[40px]">#</th>
          <% if col1_label.present? %>
            <th class="text-left px-3 py-2 font-medium <%= col_count == 1 ? '' : 'w-[30%]' %>"><%= col1_label %></th>
          <% end %>
          <% if col2_label.present? %>
            <th class="text-left px-3 py-2 font-medium"><%= col2_label %></th>
          <% end %>
          <% if col3_label.present? %>
            <th class="text-left px-3 py-2 font-medium w-[22%]"><%= col3_label %></th>
          <% end %>
          <th class="px-3 py-2 w-[40px]"></th>
        </tr>
      </thead>
      <tbody data-row-editor-target="tbody">
        <% f.fields_for :lesson_rows, section_rows do |lr| %>
          <tr class="border-b border-line hover:bg-stone-50">
            <%= lr.hidden_field :_destroy, value: "0", class: "destroy-flag" %>
            <%= lr.hidden_field :section %>
            <%= lr.hidden_field :position %>
            <td class="px-3 py-1.5 text-muted font-mono text-xs text-right select-none"><%= lr.object.position %>.</td>
            <% if col1_label.present? %>
              <td class="px-2 py-1.5">
                <%= lr.text_area :col_1, rows: 2, class: "vocab-cell-input resize-y", placeholder: col1_label %>
              </td>
            <% end %>
            <% if col2_label.present? %>
              <td class="px-2 py-1.5">
                <%= lr.text_area :col_2, rows: 2, class: "vocab-cell-input resize-y", placeholder: col2_label %>
              </td>
            <% end %>
            <% if col3_label.present? %>
              <td class="px-2 py-1.5">
                <%= lr.text_area :col_3, rows: 2, class: "vocab-cell-input resize-y", placeholder: col3_label %>
              </td>
            <% end %>
            <td class="px-2 py-1.5 text-center">
              <button type="button" data-action="click->row-editor#removeRow"
                      class="text-stone-300 hover:text-red-500 transition-colors text-lg leading-none"
                      title="Scrios">×</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# JS template for new rows in this section %>
<template id="row-template-<%= section %>">
  <tr class="border-b border-line hover:bg-stone-50">
    <input type="hidden" name="lesson[lesson_rows_attributes][NEW_INDEX][_destroy]" value="0" class="destroy-flag">
    <input type="hidden" name="lesson[lesson_rows_attributes][NEW_INDEX][section]" value="<%= section %>">
    <input type="hidden" name="lesson[lesson_rows_attributes][NEW_INDEX][position]" value="999">
    <td class="px-3 py-1.5 text-muted text-xs text-right">—</td>
    <% if col1_label.present? %>
      <td class="px-2 py-1.5">
        <textarea name="lesson[lesson_rows_attributes][NEW_INDEX][col_1]"
                  rows="2" class="vocab-cell-input resize-y" placeholder="<%= col1_label %>"></textarea>
      </td>
    <% end %>
    <% if col2_label.present? %>
      <td class="px-2 py-1.5">
        <textarea name="lesson[lesson_rows_attributes][NEW_INDEX][col_2]"
                  rows="2" class="vocab-cell-input resize-y" placeholder="<%= col2_label %>"></textarea>
      </td>
    <% end %>
    <% if col3_label.present? %>
      <td class="px-2 py-1.5">
        <textarea name="lesson[lesson_rows_attributes][NEW_INDEX][col_3]"
                  rows="2" class="vocab-cell-input resize-y" placeholder="<%= col3_label %>"></textarea>
      </td>
    <% end %>
    <td class="px-2 py-1.5 text-center">
      <button type="button" data-action="click->row-editor#removeRow"
              class="text-stone-300 hover:text-red-500 transition-colors text-lg leading-none"
              title="Scrios">×</button>
    </td>
  </tr>
</template>
