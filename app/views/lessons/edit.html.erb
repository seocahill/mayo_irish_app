<div class="flex items-center justify-between mb-8">
  <div>
    <div class="text-sm text-muted uppercase tracking-widest mb-1"><%= t(".editing", number: @lesson.number) %></div>
    <h1 class="text-2xl font-display text-ink"><%= @lesson.title %></h1>
  </div>
  <a href="<%= lesson_path(@lesson) %>" class="text-sm text-muted hover:text-ink transition-colors">
    <%= t(".back_to_lesson") %>
  </a>
</div>

<%# ══════════════════════════════════════════════════════════════
    ZONE 1 — LESSON DETAILS
    Title, position, vocabulary, vocab notes
    ══════════════════════════════════════════════════════════════ %>
<div class="mb-10">
  <div class="flex items-center gap-3 mb-4">
    <div class="flex items-center justify-center w-7 h-7 rounded-full bg-ink text-surface text-xs font-bold">1</div>
    <div>
      <h2 class="font-bold text-ink leading-none"><%= t(".details_title") %></h2>
      <p class="text-xs text-muted mt-0.5"><%= t(".details_description") %></p>
    </div>
  </div>

  <div class="pl-10 space-y-4">
    <%# Title %>
    <%= form_with model: @lesson, class: "bg-surface rounded-sm border border-line px-6 py-5" do |f| %>
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div class="col-span-2">
          <label class="editor-label"><%= t(".lesson_title") %></label>
          <%= f.text_field :title, class: "editor-input text-lg font-semibold" %>
        </div>
        <div>
          <label class="editor-label"><%= t(".position") %></label>
          <%= f.number_field :position, class: "editor-input", min: 0 %>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-ink cursor-pointer">
          <%= f.check_box :published, class: "rounded border-stone-300 text-ink focus:ring-ink" %>
          <span><%= t(".published") %> <span class="text-muted"><%= t(".published_note") %></span></span>
        </label>
        <%= f.submit t("shared.save"), class: "btn-solid" %>
      </div>
    <% end %>

    <%# Vocabulary %>
    <div class="bg-surface rounded-sm border border-line overflow-hidden">
      <div class="px-6 py-4 border-b border-line flex items-center justify-between">
        <h3 class="font-semibold text-ink"><%= t(".vocabulary") %></h3>
      </div>
      <%= form_with model: @lesson, data: { controller: "vocab-editor" } do |f| %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" id="vocab-table">
            <thead>
              <tr class="bg-canvas border-b border-line text-muted text-xs uppercase tracking-wide">
                <th class="text-left px-3 py-2 font-medium w-[22%]"><%= t(".irish") %></th>
                <th class="text-left px-3 py-2 font-medium w-[18%]"><%= t(".pronunciation") %></th>
                <th class="text-left px-3 py-2 font-medium w-[16%]"><%= t(".plural") %></th>
                <th class="text-left px-3 py-2 font-medium w-[8%]"><%= t(".gender") %></th>
                <th class="text-left px-3 py-2 font-medium"><%= t(".english") %></th>
                <th class="px-3 py-2 w-8"></th>
              </tr>
            </thead>
            <tbody data-vocab-editor-target="tbody">
              <%= f.fields_for :vocabulary_items do |vi| %>
                <%= render "vocabulary_item_row", f: vi %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-6 py-3 border-t border-line flex items-center justify-between">
          <button type="button" data-action="click->vocab-editor#addRow"
                  class="text-sm text-ink hover:text-ink font-medium transition-colors">
            <%= t(".new_word") %>
          </button>
          <%= f.submit t("shared.save"), class: "btn-solid" %>
        </div>
      <% end %>
    </div>

    <%# Vocab notes %>
    <%= form_with model: @lesson, class: "bg-surface rounded-sm border border-line overflow-hidden" do |f| %>
      <div class="px-6 py-4 border-b border-line">
        <h3 class="font-semibold text-ink"><%= t(".vocabulary_notes") %></h3>
      </div>
      <div class="px-6 py-4">
        <%= f.rich_text_area :vocabulary_notes_content %>
      </div>
      <div class="px-6 py-4 border-t border-line flex justify-end">
        <%= f.submit t("shared.save"), class: "btn-solid" %>
      </div>
    <% end %>
  </div>
</div>

<%# ══════════════════════════════════════════════════════════════
    ZONE 2 — RICH MEDIA CONTENT
    Free-form blocks: text, image, video, PDF, audio
    ══════════════════════════════════════════════════════════════ %>
<div class="mb-10">
  <div class="flex items-center gap-3 mb-4">
    <div class="flex items-center justify-center w-7 h-7 rounded-full bg-foghlaim text-surface text-xs font-bold">2</div>
    <div>
      <h2 class="font-bold text-ink leading-none"><%= t(".rich_content") %></h2>
      <p class="text-xs text-muted mt-0.5"><%= t(".rich_content_description") %></p>
    </div>
  </div>

  <div class="pl-10" data-controller="blocks" data-blocks-reorder-url-value="<%= reorder_lesson_lesson_blocks_path(@lesson) %>">
    <div class="space-y-3 mb-3" data-blocks-target="list">
      <%= render @lesson.lesson_blocks %>
    </div>

    <div class="bg-foghlaim/10 border border-foghlaim/40 rounded-sm px-5 py-4">
      <p class="text-xs font-semibold text-foghlaim uppercase tracking-wide mb-3"><%= t(".add_block") %></p>
      <div class="flex flex-wrap gap-2">
        <% LessonBlock::TYPES.each do |type| %>
          <%= button_to t("lesson_blocks.types.#{type}"),
                lesson_lesson_blocks_path(@lesson, block_type: type),
                method: :post,
                data: { turbo: false },
                class: "text-xs px-3 py-1.5 rounded-sm border border-foghlaim/40 text-foghlaim hover:bg-foghlaim hover:text-surface transition-colors bg-surface font-medium" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# ══════════════════════════════════════════════════════════════
    ZONE 3 — PARSED LESSON CONTENT
    Grammar rules (from OCR parse)
    ══════════════════════════════════════════════════════════════ %>
<% if @lesson.grammar_rules.any? %>
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center justify-center w-7 h-7 rounded-full bg-ink text-surface text-xs font-bold">3</div>
      <div>
        <h2 class="font-bold text-ink leading-none"><%= t(".content_title") %></h2>
        <p class="text-xs text-muted mt-0.5"><%= t(".content_description") %></p>
      </div>
    </div>

    <div class="pl-10 space-y-6">
      <%# Grammar %>
      <% if @lesson.grammar_rules.any? %>
        <div>
          <h3 class="text-xs font-semibold text-muted uppercase tracking-widest mb-3"><%= t(".grammar") %></h3>
          <div class="space-y-4">
            <% @lesson.grammar_rules.each do |rule| %>
              <div class="bg-surface rounded-sm border border-line overflow-hidden">
                <turbo-frame id="<%= dom_id(rule) %>">
                  <div class="bg-canvas border-b border-line text-ink px-5 py-3 flex items-center justify-between">
                    <span class="font-semibold text-sm"><%= rule.number %>. <%= rule.title %></span>
                    <a href="<%= edit_grammar_rule_path(rule) %>" class="text-muted hover:text-ink text-xs transition-colors"><%= t("shared.edit") %></a>
                  </div>
                </turbo-frame>
                <% rule.grammar_sections.each do |section| %>
                  <turbo-frame id="<%= dom_id(section) %>">
                    <div class="border-b border-line last:border-0 flex items-start justify-between gap-4 px-5 py-3 hover:bg-canvas transition-colors">
                      <div class="flex-1 min-w-0">
                        <% if section.label.present? %>
                          <p class="text-xs font-semibold text-muted uppercase tracking-wide mb-1"><%= section.label %></p>
                        <% end %>
                        <div class="text-sm text-ink lexxy-content line-clamp-2">
                          <%= section.body %>
                        </div>
                      </div>
                      <a href="<%= edit_grammar_section_path(section) %>" class="text-muted hover:text-ink text-xs shrink-0 transition-colors"><%= t("shared.edit") %></a>
                    </div>
                  </turbo-frame>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
<% end %>

<%# ══════════════════════════════════════════════════════════════
    ZONE 4 — TUTOR / CHAT SETTINGS
    ══════════════════════════════════════════════════════════════ %>
<div class="mb-10">
  <div class="flex items-center gap-3 mb-4">
    <div class="flex items-center justify-center w-7 h-7 rounded-full bg-cleacht text-surface text-xs font-bold">4</div>
    <div>
      <h2 class="font-bold text-ink leading-none"><%= t(".tutor_title") %></h2>
      <p class="text-xs text-muted mt-0.5"><%= t(".tutor_description") %></p>
    </div>
  </div>

  <div class="pl-10">
    <%= form_with model: @lesson, class: "bg-surface rounded-sm border border-cleacht/30 overflow-hidden" do |f| %>
      <div class="px-6 py-4 border-b border-cleacht/30 flex items-center justify-between bg-cleacht/10">
        <div>
          <h3 class="font-semibold text-ink"><%= t(".tutor_instructions") %></h3>
          <p class="text-xs text-muted mt-0.5"><%= t(".tutor_focus") %></p>
        </div>
        <%= link_to lesson_chat_path(@lesson),
              class: "inline-flex items-center gap-1.5 text-sm bg-cleacht text-surface px-3 py-1.5 rounded-sm hover:opacity-90 transition-colors font-medium" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-3 3v-3z"/>
          </svg>
          <%= t(".open_chat") %>
        <% end %>
      </div>
      <div class="px-6 py-4">
        <%= f.text_area :tutor_prompt,
              rows: 5,
              placeholder: t(".tutor_placeholder"),
              class: "w-full rounded-sm border border-line px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-ink resize-y" %>
      </div>
      <div class="px-6 py-4 border-t border-cleacht/30 flex justify-end bg-cleacht/10">
        <%= f.submit t("shared.save"), class: "btn-solid" %>
      </div>
    <% end %>
  </div>
</div>

<%# Template row for vocab JS cloning %>
<template id="vocab-row-template">
  <tr class="border-b border-line hover:bg-canvas vocab-row">
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][irish]" class="vocab-cell-input" placeholder="<%= t(".word_placeholder") %>"></td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][phonetic]" class="vocab-cell-input font-mono text-xs" placeholder="<%= t(".pronunciation_placeholder") %>"></td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][plural]" class="vocab-cell-input" placeholder="<%= t(".plural_placeholder") %>"></td>
    <td class="px-2 py-1.5">
      <select name="lesson[vocabulary_items_attributes][NEW_INDEX][gender]" class="vocab-cell-input">
        <option value="m"><%= t("lessons.genders.masculine") %></option>
        <option value="f"><%= t("lessons.genders.feminine") %></option>
      </select>
    </td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][english]" class="vocab-cell-input" placeholder="<%= t(".meaning_placeholder") %>"></td>
    <td class="px-2 py-1.5 text-center">
      <button type="button" data-action="click->vocab-editor#removeRow" class="text-muted hover:text-red-500 transition-colors text-lg leading-none" title="<%= t("shared.delete") %>">×</button>
    </td>
  </tr>
</template>
