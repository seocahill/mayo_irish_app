<div class="flex items-center justify-between mb-8">
  <div>
    <div class="text-sm text-stone-400 uppercase tracking-widest mb-1">Á chur in eagar · Ceacht <%= @lesson.number %></div>
    <h1 class="text-2xl font-bold text-stone-800"><%= @lesson.title %></h1>
  </div>
  <a href="<%= lesson_path(@lesson) %>" class="text-sm text-stone-500 hover:text-stone-800 transition-colors">
    ← Ar ais go dtí an ceacht
  </a>
</div>

<%# ── TITLE ───────────────────────────────────────────────────── %>
<%= form_with model: @lesson, class: "bg-white rounded-xl border border-stone-200 px-6 py-5 mb-6" do |f| %>
  <div class="grid grid-cols-3 gap-4 mb-4">
    <div class="col-span-2">
      <label class="editor-label">Teideal an Cheachta</label>
      <%= f.text_field :title, class: "editor-input text-lg font-semibold" %>
    </div>
    <div>
      <label class="editor-label">Suíomh (position)</label>
      <%= f.number_field :position, class: "editor-input", min: 0 %>
    </div>
  </div>
  <div class="flex justify-end">
    <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
  </div>
<% end %>

<%# ── VOCABULARY ───────────────────────────────────────────────── %>
<div class="bg-white rounded-xl border border-stone-200 mb-6 overflow-hidden">
  <div class="px-6 py-4 border-b border-stone-100 flex items-center justify-between">
    <h2 class="font-bold text-stone-800">Stór Focal</h2>
  </div>
  <%= form_with model: @lesson, data: { controller: "vocab-editor" } do |f| %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm" id="vocab-table">
        <thead>
          <tr class="bg-stone-50 border-b border-stone-200 text-stone-500 text-xs uppercase tracking-wide">
            <th class="text-left px-3 py-2 font-medium w-[22%]">Gaeilge</th>
            <th class="text-left px-3 py-2 font-medium w-[18%]">Fuaimniú</th>
            <th class="text-left px-3 py-2 font-medium w-[16%]">Iolra</th>
            <th class="text-left px-3 py-2 font-medium w-[8%]">Inscne</th>
            <th class="text-left px-3 py-2 font-medium">Béarla</th>
            <th class="px-3 py-2 w-8"></th>
          </tr>
        </thead>
        <tbody data-vocab-editor-target="tbody">
          <%= f.fields_for :vocabulary_items do |vi| %>
            <%= render "vocabulary_item_row", f: vi %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="px-6 py-3 border-t border-stone-100 flex items-center justify-between">
      <button type="button" data-action="click->vocab-editor#addRow"
              class="text-sm text-emerald-800 hover:text-emerald-700 font-medium transition-colors">
        + Focal nua
      </button>
      <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

<%# ── VOCAB NOTES ─────────────────────────────────────────────── %>
<%= form_with model: @lesson, class: "bg-white rounded-xl border border-stone-200 overflow-hidden mb-6" do |f| %>
  <div class="px-6 py-4 border-b border-stone-100">
    <h2 class="font-bold text-stone-800">Nótaí Focail</h2>
  </div>
  <div class="px-6 py-4">
    <%= f.rich_text_area :vocabulary_notes_content %>
  </div>
  <div class="px-6 py-4 border-t border-stone-100 flex justify-end">
    <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
  </div>
<% end %>

<%# ── GRAMMAR ─────────────────────────────────────────────────── %>
<% if @lesson.grammar_rules.any? %>
  <div class="mb-6">
    <h2 class="lesson-section-heading">Gramadach</h2>
    <div class="space-y-4">
      <% @lesson.grammar_rules.each do |rule| %>
        <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
          <turbo-frame id="<%= dom_id(rule) %>">
            <div class="bg-emerald-900 text-white px-5 py-3 flex items-center justify-between">
              <span class="font-bold text-sm"><%= rule.number %>. <%= rule.title %></span>
              <a href="<%= edit_grammar_rule_path(rule) %>" class="text-emerald-300 hover:text-white text-xs transition-colors">Cuir in eagar</a>
            </div>
          </turbo-frame>
          <% rule.grammar_sections.each do |section| %>
            <turbo-frame id="<%= dom_id(section) %>">
              <div class="border-b border-stone-100 last:border-0 flex items-start justify-between gap-4 px-5 py-3 hover:bg-stone-50 transition-colors">
                <div class="flex-1 min-w-0">
                  <% if section.label.present? %>
                    <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-1"><%= section.label %></p>
                  <% end %>
                  <div class="text-sm text-stone-700 lexxy-content line-clamp-2">
                    <%= section.body %>
                  </div>
                </div>
                <a href="<%= edit_grammar_section_path(section) %>" class="text-stone-400 hover:text-emerald-800 text-xs shrink-0 transition-colors">Cuir in eagar</a>
              </div>
            </turbo-frame>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── TEXTS ────────────────────────────────────────────────────── %>
<% if @lesson.text_passages.any? %>
  <div class="mb-6">
    <h2 class="lesson-section-heading">Téacsanna</h2>
    <div class="space-y-4">
      <% @lesson.text_passages.each do |passage| %>
        <turbo-frame id="<%= dom_id(passage) %>" class="block bg-white rounded-xl border border-stone-200 overflow-hidden">
          <div class="bg-stone-700 text-white px-5 py-3 flex items-center justify-between">
            <span class="font-bold text-sm"><%= passage.title.presence || "Téacs" %></span>
            <a href="<%= edit_text_passage_path(passage) %>" class="text-stone-300 hover:text-white text-xs transition-colors">Cuir in eagar</a>
          </div>
          <div class="px-5 py-3 text-sm text-stone-600 lexxy-content line-clamp-3">
            <%= passage.body %>
          </div>
        </turbo-frame>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── EXERCISES ────────────────────────────────────────────────── %>
<% if @lesson.exercises.any? %>
  <div class="mb-6">
    <h2 class="lesson-section-heading">Cleachtaí</h2>
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <% @lesson.exercises.each do |ex| %>
        <turbo-frame id="<%= dom_id(ex) %>">
          <div class="flex items-start gap-4 px-5 py-3 border-b border-stone-100 last:border-0 hover:bg-stone-50 transition-colors">
            <span class="text-stone-400 font-mono text-xs w-6 shrink-0 pt-0.5"><%= ex.number %>.</span>
            <span class="text-stone-700 text-sm flex-1"><%= ex.prompt %></span>
            <a href="<%= edit_exercise_path(ex) %>" class="text-stone-400 hover:text-emerald-800 text-xs shrink-0 transition-colors">Cuir in eagar</a>
          </div>
        </turbo-frame>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── CONTENT BLOCKS ──────────────────────────────────────────── %>
<div class="mb-6" data-controller="blocks" data-blocks-reorder-url="<%= reorder_lesson_lesson_blocks_path(@lesson) %>">
  <div class="flex items-center justify-between mb-3">
    <h2 class="lesson-section-heading mb-0">Ábhar Saibhir</h2>
  </div>

  <div class="space-y-3" data-blocks-target="list">
    <%= render @lesson.lesson_blocks %>
  </div>

  <%# Add block buttons %>
  <div class="mt-3 flex flex-wrap gap-2">
    <% LessonBlock::TYPES.each do |type| %>
      <%= button_to type.capitalize,
            lesson_lesson_blocks_path(@lesson, block_type: type),
            method: :post,
            data: { turbo: false },
            class: "text-xs px-3 py-1.5 rounded-lg border border-stone-300 text-stone-600 hover:border-emerald-600 hover:text-emerald-800 transition-colors bg-white" %>
    <% end %>
  </div>
</div>

<%# ── TUTOR PROMPT ───────────────────────────────────────────── %>
<%= form_with model: @lesson, class: "bg-white rounded-xl border border-stone-200 overflow-hidden mb-6" do |f| %>
  <div class="px-6 py-4 border-b border-stone-100 flex items-center justify-between">
    <div>
      <h2 class="font-bold text-stone-800">Treoracha an Mhúinteora</h2>
      <p class="text-xs text-stone-400 mt-0.5">Fág folamh chun an réamhshocrú a úsáid</p>
    </div>
    <%= link_to "Oscail comhrá", lesson_chat_path(@lesson),
          class: "text-sm text-emerald-700 hover:text-emerald-900 font-medium transition-colors" %>
  </div>
  <div class="px-6 py-4">
    <%= f.text_area :tutor_prompt,
          rows: 5,
          placeholder: "e.g. Focus on noun gender. Test common nouns first, then ask the student to apply the gender rules to unfamiliar words...",
          class: "w-full rounded-lg border border-stone-200 px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent resize-y" %>
  </div>
  <div class="px-6 py-4 border-t border-stone-100 flex justify-end">
    <%= f.submit "Sábháil", class: "bg-emerald-800 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
  </div>
<% end %>

<%# Template row for vocab JS cloning %>
<template id="vocab-row-template">
  <tr class="border-b border-stone-100 hover:bg-stone-50 vocab-row">
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][irish]" class="vocab-cell-input" placeholder="focal"></td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][phonetic]" class="vocab-cell-input font-mono text-xs" placeholder="/fuaimniú/"></td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][plural]" class="vocab-cell-input" placeholder="iolra"></td>
    <td class="px-2 py-1.5">
      <select name="lesson[vocabulary_items_attributes][NEW_INDEX][gender]" class="vocab-cell-input">
        <option value="m">fir.</option>
        <option value="f">bain.</option>
      </select>
    </td>
    <td class="px-2 py-1.5"><input type="text" name="lesson[vocabulary_items_attributes][NEW_INDEX][english]" class="vocab-cell-input" placeholder="meaning"></td>
    <td class="px-2 py-1.5 text-center">
      <button type="button" data-action="click->vocab-editor#removeRow" class="text-stone-300 hover:text-red-500 transition-colors text-lg leading-none" title="Scrios">×</button>
    </td>
  </tr>
</template>
