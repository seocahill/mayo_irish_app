<% if words.present? %>
  <section aria-labelledby="tricky-heading">
    <h2 id="tricky-heading" class="eyebrow mb-1"><%= t("reviews.tricky.heading") %></h2>
    <p class="text-sm text-muted mb-2"><%= t("reviews.tricky.hint") %></p>
    <ul class="flex flex-col divide-y divide-line">
      <% words.each do |question| %>
        <li class="py-3 flex flex-col gap-1">
          <span class="font-display text-xl"><%= question.source.irish %></span>
          <span class="text-muted"><%= question.source.english %></span>
          <% if question.lesson.published? || current_user&.admin? %>
            <%= link_to t("reviews.summary.in_lesson", lesson: question.lesson.display_title), lesson_path(question.lesson), class: "text-sm underline text-muted" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
