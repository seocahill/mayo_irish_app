<%# A word's gender, genitive and plural as the course holds them, so they are learned with the word. Renders nothing when none are set. %>
<% item = question.source %>
<% if item.is_a?(VocabularyItem) && (VocabularyItem::GENDERS.key?(item.gender) || item.genitive.present? || item.plural.present?) %>
  <p class="mt-3 text-sm text-muted flex flex-wrap gap-x-4 gap-y-1" data-test="noun-forms">
    <% if item.gender == "f" %>
      <span><%= t("reviews.noun_forms.feminine") %></span>
    <% elsif item.gender == "m" %>
      <span><%= t("reviews.noun_forms.masculine") %></span>
    <% end %>
    <% if item.genitive.present? %>
      <span><%= t("reviews.noun_forms.genitive") %> <span lang="ga" class="italic text-ink"><%= item.genitive %></span><% if item.genitive_source_entry_id.present? %> <span class="chip text-[10px]" title="<%= t("reviews.noun_forms.attested_in_abairt") %>"><%= t("reviews.noun_forms.abairt") %></span><% end %></span>
    <% end %>
    <% if item.plural.present? %>
      <span><%= t("reviews.noun_forms.plural") %> <span lang="ga" class="italic text-ink"><%= item.plural %></span><% if item.plural_source_entry_id.present? %> <span class="chip text-[10px]" title="<%= t("reviews.noun_forms.attested_in_abairt") %>"><%= t("reviews.noun_forms.abairt") %></span><% end %></span>
    <% end %>
  </p>
<% end %>
