<div class="max-w-xl mx-auto">
  <div class="card p-6 sm:p-10 flex flex-col gap-6">
    <div>
      <p class="eyebrow text-foghlaim mb-2"><%= t(".round_complete") %></p>
      <h1 class="font-display text-4xl leading-tight"><%= t(".score", correct: @correct, answered: @answered) %></h1>
      <p class="text-muted mt-1"><%= t(".correct_this_round") %></p>
    </div>
    <%= render "forecast", forecast: @forecast %>
    <div class="flex flex-col sm:flex-row gap-2">
      <%= link_to t(".keep_going"), review_path, class: "btn-solid" %>
      <%= link_to t(".back_home"), root_path, class: "btn-outline border-line text-muted" %>
    </div>
  </div>
</div>
