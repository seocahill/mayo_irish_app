<% prompt_lang = @question.prompt_lang %>
<div class="max-w-xl mx-auto flex flex-col gap-6">
  <div class="flex items-center justify-between gap-3">
    <%= link_to lesson_path(@question.lesson), class: "min-w-0 text-sm text-muted hover:text-ink transition-colors inline-flex items-center gap-1" do %>
      <span class="shrink-0">←</span>
      <span class="truncate"><%= @question.lesson.display_title %></span>
    <% end %>
    <span class="eyebrow tabular-nums shrink-0"><%= t(".question_count", position: @position, count: @count) %></span>
  </div>

  <% if @question.gender? %>
    <%# A noun's gender as an editor marked it: two choices, graded like the other multiple-choice cards. %>
    <div class="card p-6 sm:p-8" data-testid="gender-card">
      <p class="eyebrow text-foghlaim mb-3"><%= t(".gender.eyebrow") %></p>
      <p class="font-display text-3xl sm:text-4xl leading-tight mb-1 break-words">
        <span lang="ga" class="italic"><%= @question.prompt %></span>
        <span class="ml-2 align-middle"><%= render "reviews/audio", question: @question %></span>
      </p>
      <p class="text-sm text-muted mb-8"><%= @question.source.english %></p>
      <%= form_with url: answer_review_path, method: :post, class: "grid grid-cols-2 gap-2", data: { turbo: false } do |f| %>
        <%= f.hidden_field :question_id, value: @question.id %>
        <% QuizQuestion::GENDERS.each do |gender| %>
          <button type="submit" name="choice" value="<%= gender %>"
                  class="px-4 py-4 rounded-sm border border-line bg-surface hover:bg-canvas hover:border-ink focus-visible:outline-2 focus-visible:outline-ink transition-colors text-lg cursor-pointer">
            <%= gender_name(gender) %>
          </button>
        <% end %>
      <% end %>
    </div>
  <% elsif @question.noun_form? %>
    <%# A noun's plural or genitive as the course holds it: the learner says it, then sees the course's form. %>
    <% item = @question.source %>
    <% attested = item.public_send("#{@question.direction}_source_entry_id").present? %>
    <div class="card p-6 sm:p-8" data-controller="reveal" data-testid="noun-form-card">
      <p class="eyebrow text-foghlaim mb-3"><%= noun_form_label(@question) %></p>
      <p class="font-display text-2xl sm:text-3xl leading-snug mb-1 break-words">
        <%= noun_form_prompt(@question) %>
      </p>
      <%# No gender here: it has a card of its own. %>
      <p class="text-sm text-muted mb-1"><%= item.english %></p>
      <p class="text-sm text-muted mb-8"><%= t(".noun_form.hint") %></p>

      <button type="button" data-reveal-target="button" data-action="reveal#show" class="btn-solid w-full sm:w-auto"><%= t(".show") %></button>

      <div hidden data-reveal-target="hidden" class="grid gap-4">
        <div class="pt-2 border-t border-line">
          <p class="eyebrow mb-1"><%= t(".noun_form.answer") %></p>
          <p class="text-lg">
            <span lang="ga" class="font-semibold italic break-words"><%= @question.answer %></span>
            <% if attested %><span class="chip text-[10px] ml-1" title="<%= t("reviews.noun_forms.attested_in_abairt") %>"><%= t("reviews.noun_forms.abairt") %></span><% end %>
          </p>
        </div>
        <p class="eyebrow"><%= t(".how_did_it_go") %></p>
        <%= render "reviews/ratings", question: @question %>
      </div>
    </div>
  <% elsif @question.self_rated? %>
    <%# An exercise the editors have answered: the learner's own Irish first, then the editors' answer. %>
    <div class="card p-6 sm:p-8" data-controller="reveal" data-testid="exercise-card">
      <p class="eyebrow text-foghlaim mb-3"><%= t(".exercise") %></p>
      <p class="font-display text-2xl sm:text-3xl leading-snug mb-3 break-words"><%= @question.prompt %></p>
      <p class="text-sm text-muted mb-8"><%= t(".exercise_hint") %></p>

      <button type="button" data-reveal-target="button" data-action="reveal#show" class="btn-solid w-full sm:w-auto"><%= t(".show") %></button>

      <div hidden data-reveal-target="hidden" class="grid gap-4">
        <div class="pt-2 border-t border-line">
          <p class="eyebrow mb-1"><%= t(".exercise_answer") %></p>
          <p lang="ga" class="text-lg font-semibold italic break-words"><%= @question.answer %></p>
          <p class="text-xs text-muted mt-1"><%= t(".exercise_more_than_one_way") %></p>
        </div>
        <p class="eyebrow"><%= t(".how_did_it_go") %></p>
        <%= render "reviews/ratings", question: @question %>
      </div>
    </div>
  <% elsif @say_it %>
    <% audio_html = render("reviews/audio", question: @question) %>
    <% audio_first = prompt_lang == "ga" && audio_html.present? %>
    <div class="card p-6 sm:p-8" data-controller="reveal">
      <p class="eyebrow text-foghlaim mb-3">
        <%= audio_first ? t(".say_it_listen") : (prompt_lang == "ga" ? t(".meaning_in_english") : t(".say_it_aloud")) %>
      </p>
      <% if audio_first %>
        <div class="mb-6" data-testid="say-it-audio"><%= audio_html %></div>
        <p class="font-display text-3xl sm:text-4xl leading-tight mb-8 break-words italic" hidden data-reveal-target="hidden"><%= @question.prompt %></p>
      <% else %>
        <p class="font-display text-3xl sm:text-4xl leading-tight mb-8 break-words <%= "italic" if prompt_lang == "ga" %>"><%= @question.prompt %></p>
      <% end %>

      <button type="button" data-reveal-target="button" data-action="reveal#show" class="btn-solid w-full sm:w-auto"><%= t(".show") %></button>

      <div hidden data-reveal-target="hidden" class="grid gap-4">
        <p class="text-lg pt-2 border-t border-line">
          <span class="font-semibold <%= @question.answer_lang == "ga" ? "italic" : "" %>"><%= @question.answer %></span>
          <% if !audio_first && prompt_lang == "en" %><span class="ml-2 align-middle"><%= audio_html %></span><% end %>
        </p>
        <% if audio_html.present? %>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
            <span id="say-it-compare"><%= t(".compare") %></span>
            <%= render "shared/record_yourself", button_class: "inline-flex items-center justify-center min-w-12 min-h-12",
                                                 show_status: "", testid: "say-it-recorder", labelledby: "say-it-compare", note: true %>
          </div>
        <% end %>
        <p class="eyebrow"><%= t(".how_did_it_go") %></p>
        <%= render "reviews/ratings", question: @question %>
      </div>
    </div>
  <% else %>
    <div class="card p-6 sm:p-8">
      <p class="eyebrow text-foghlaim mb-3">
        <%= prompt_lang == "ga" ? t(".meaning_in_english") : t(".how_to_say_in_irish") %>
      </p>
      <p class="font-display text-3xl sm:text-4xl leading-tight mb-8 break-words">
        <%= @question.prompt %>
        <% if prompt_lang == "ga" %><span class="ml-2 align-middle"><%= render "reviews/audio", question: @question %></span><% end %>
      </p>

      <%= form_with url: answer_review_path, method: :post, class: "grid gap-2", data: { turbo: false } do |f| %>
        <%= f.hidden_field :question_id, value: @question.id %>
        <% @question.choices.each do |choice| %>
          <button type="submit" name="choice" value="<%= choice %>"
                  class="text-left px-4 py-4 rounded-sm border border-line bg-surface hover:bg-canvas hover:border-ink focus-visible:outline-2 focus-visible:outline-ink transition-colors text-lg break-words cursor-pointer">
            <%= choice %>
          </button>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="text-center">
    <%= button_to t(".quit"), reset_review_path, method: :delete,
          class: "text-sm text-muted hover:text-ink bg-transparent border-0 cursor-pointer" %>
  </div>
</div>
