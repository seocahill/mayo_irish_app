<%# Where the learner has got to, in things they have done. The next step is shown plainly, with no streaks or points. %>
<ul class="flex flex-col gap-1.5 text-sm">
  <% strands.each do |strand| %>
    <li class="text-muted">
      <% if strand.reached %>
        <span class="text-ink"><%= t("milestones.#{strand.key}.reached", count: strand.reached) %></span>
      <% else %>
        <%= t("milestones.#{strand.key}.not_yet") %>
      <% end %>
      <% if strand.key == :words && course_words.to_i.positive? && strand.value.positive? %>
        <span>· <%= t("milestones.words.of_course", known: strand.value, total: course_words) %></span>
      <% end %>
      <% if strand.next_step %>
        <span>· <%= link_to t("milestones.#{strand.key}.next", count: strand.next_step, remaining: strand.remaining),
                            { words: review_path, listening: listens_path }.fetch(strand.key, lessons_path),
                            class: "underline underline-offset-2 hover:text-ink focus-visible:outline focus-visible:outline-2 inline-block py-3 -my-2" %></span>
      <% end %>
    </li>
  <% end %>
</ul>
