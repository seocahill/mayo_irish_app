<%# Hidden until the install controller decides the learner is ready (3rd day of use). %>
<section hidden data-controller="install" aria-labelledby="install-heading" class="bg-surface border border-line rounded-sm px-4 py-4 flex flex-col gap-3">
  <h2 id="install-heading" class="font-mono text-xs uppercase tracking-wider text-foghlaim"><%= t(".heading") %></h2>
  <p class="text-muted leading-snug"><%= t(".body") %></p>
  <p hidden data-install-target="ios" class="leading-snug"><%= t(".ios") %></p>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" hidden data-install-target="android" data-action="install#install" class="btn-outline"><%= t(".install") %></button>
    <button type="button" data-action="install#dismiss" class="text-sm text-muted underline underline-offset-2 py-3 min-h-11"><%= t(".not_now") %></button>
  </div>
</section>
