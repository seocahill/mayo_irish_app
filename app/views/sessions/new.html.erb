<div class="max-w-md mx-auto mt-8">
  <h1 class="text-2xl font-display text-ink mb-6"><%= t(".title") %></h1>

  <%= form_with url: session_url do |form| %>
    <div class="space-y-4">
      <div>
        <%= form.label :email_address, t(".email"), class: "block text-sm font-semibold mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username",
              value: params[:email_address],
              class: "field" %>
      </div>

      <div>
        <%= form.label :password, t(".password"), class: "block text-sm font-semibold mb-1" %>
        <%= form.password_field :password, required: true,
              autocomplete: "current-password",
              maxlength: 72,
              class: "field" %>
      </div>

      <%= form.submit t(".submit"),
            class: "btn-solid w-full" %>
    </div>
  <% end %>

  <div class="mt-6 text-sm text-muted space-y-2">
    <p><%= link_to t(".forgot_password"), new_password_path, class: "text-ink underline underline-offset-2" %></p>
    <p><%= t(".no_account_html", link: link_to(t(".register_here"), new_registration_path, class: "text-ink underline underline-offset-2")) %></p>
  </div>
</div>
